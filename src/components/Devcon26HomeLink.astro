<a class="devcon26-home-link" href="/"><span aria-hidden="true">←</span> Back to DevCongress</a>

<style>
  .devcon26-home-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    color: #b50068;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }

  .devcon26-home-link > span {
    font-size: 16px;
    line-height: 1;
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .devcon26-home-link:hover {
      color: #85004d;
      text-decoration: none;
    }

    .devcon26-home-link:hover > span {
      transform: translateX(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .devcon26-home-link > span {
      transition: none;
    }

    .devcon26-home-link:hover > span {
      transform: none;
    }
  }

  .devcon26-home-link:focus-visible {
    outline: 2px solid var(--pink);
    outline-offset: 4px;
  }

  @media print {
    .devcon26-home-link {
      display: none;
    }
  }
</style>
