---
// Astro adaptation of EMS AppDropdown; no Vue runtime required.
interface Props {
  name: string;
  label: string;
  placeholder: string;
}

const { name, label, placeholder } = Astro.props;
---

<div class="choice-field" data-choice={name}>
  <label id={`${name}-label`} for={`${name}-trigger`}>{label}</label>
  <input type="hidden" name={name} />
  <button class="choice-trigger" id={`${name}-trigger`} type="button" aria-labelledby={`${name}-label ${name}-value`} aria-controls={`${name}-options`} aria-expanded="false" aria-haspopup="listbox" aria-required="true">
    <span id={`${name}-value`} data-choice-value>{placeholder}</span>
    <span class="choice-chevron" aria-hidden="true">
      <svg viewBox="0 0 20 20" fill="none"><path d="m5.5 8 4.5 4.5L14.5 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </button>
  <div class="choice-options" id={`${name}-options`} role="listbox" aria-labelledby={`${name}-label`} hidden></div>
</div>

<style>
  .choice-field {
    position: relative;
    min-width: 0;
    display: grid;
    gap: 8px;
  }

  label {
    font-size: 14px;
    font-weight: 600;
  }

  .choice-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    min-height: 48px;
    padding: 11px 14px;
    border: 1px solid #c7c2b8;
    border-radius: 8px;
    background: #fffdf8;
    color: #111;
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    text-align: left;
  }

  .choice-chevron {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border: 1px solid #dedbd4;
    border-radius: 50%;
    color: #e8117f;
  }

  .choice-chevron svg {
    width: 16px;
    height: 16px;
  }

  [aria-expanded="true"] .choice-chevron {
    transform: rotate(180deg);
  }

  .choice-trigger:focus-visible,
  .choice-trigger[aria-expanded="true"] {
    border-color: #e8117f;
    outline: none;
  }

  .choice-trigger[aria-invalid="true"] {
    border-color: #b42318;
  }

  .choice-options {
    position: absolute;
    top: calc(100% + 4px);
    inset-inline: 0;
    z-index: 20;
    padding: 6px;
    border: 1px solid #dedbd4;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 36px rgb(17 17 17 / 14%);
    box-sizing: border-box;
    max-height: 256px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .choice-options :global([role="option"]) {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 42px;
    padding: 10px 12px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: #59564f;
    text-align: left;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  .choice-options :global([role="option"]::before) {
    content: '';
    width: 16px;
    flex-shrink: 0;
  }

  .choice-options :global([role="option"][aria-selected="true"]) {
    background: #f8ee3e;
    color: #111;
  }

  .choice-options :global([aria-selected="true"]::before) {
    content: '✓';
  }

  .choice-options :global([role="option"]:hover),
  .choice-options :global([role="option"]:focus-visible) {
    background: #f5f2e8;
    color: #111;
    outline: none;
  }

  /* Dropdown choices are flat controls, not the website's raised buttons. */
  :global(body .speaker-page .choice-field button) {
    transform: none !important;
    box-shadow: none;
    transition: none;
  }

  :global(body .speaker-page .choice-field button::after) {
    content: none;
  }
</style>
