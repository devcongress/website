---
interface Cta {
  text: string;
  color: 'pink' | 'outline' | 'white' | 'yellow';
}

interface Hero {
  eyebrow: string;
  headline: string;
  cta_primary: Cta;
  cta_secondary: Cta;
  video_label: string;
  video_live: string;
}

interface Props {
  hero: Hero;
  slackUrl: string;
  paystackUrl: string;
  youtubeEmbedUrl: string;
}

const { hero, slackUrl, paystackUrl, youtubeEmbedUrl } = Astro.props;

const colorClass: Record<string, string> = {
  pink:    'btn-primary',
  outline: 'btn-outline',
  white:   'btn-white',
  yellow:  'btn-yellow',
};
---

<section class="hero" id="hero">
  <div class="container">
    <div class="hero-top">
      <div class="hero-copy">
        <span class="eyebrow">{hero.eyebrow}</span>
        <h1 class="heading-display hero-headline">{hero.headline}</h1>
        <p class="hero-invitation">We connect all year. This December, we come together at <strong>DevCon26.</strong></p>
        <div class="hero-conference-meta">
          <time datetime="2026-12">December 2026</time>
          <p>Ghana Digital Center (formerly Accra Digital Center), Accra</p>
        </div>
        <div class="hero-ctas">
          <a
            href="/devcon26/#tickets"
            class={`btn ${colorClass[hero.cta_primary.color]} btn-hero`}
          >
            {hero.cta_primary.text} <span aria-hidden="true">↗</span>
          </a>
          <a
            href={slackUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`btn ${colorClass[hero.cta_secondary.color]} btn-hero`}
          >
            {hero.cta_secondary.text}
          </a>
          <a
            href={paystackUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-hero"
          >
            Support us
          </a>
        </div>
      </div>
      <figure class="hero-community-photo">
        <img
          src="/images/devcon26/hero-may-connections.webp"
          alt="DevCongress members chatting at a community meetup"
          width="1100"
          height="734"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>
  </div>

  <div class="hero-video-wrap">
    <div class="hero-video-bar">
      <span class="hero-video-label">{hero.video_label}</span>
      <span class="hero-video-live">{hero.video_live}</span>
    </div>
    <div class="hero-video">
      <iframe
        src={youtubeEmbedUrl}
        title="DevCongress — Community Highlight"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: 0;
  }

  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--s7);
    margin-bottom: var(--s8);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-headline {
    font-size: clamp(var(--text-3xl), 4.7vw, var(--text-4xl));
    font-weight: 700;
    margin-bottom: var(--s5);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero-invitation {
    max-width: 38ch;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .hero-invitation strong {
    font-weight: 700;
  }

  .hero-conference-meta {
    margin-top: var(--s5);
    padding-left: var(--s3);
    border-left: 3px solid var(--pink);
  }

  .hero-conference-meta time {
    font-weight: 700;
  }

  .hero-conference-meta p {
    max-width: 46ch;
    margin-top: var(--s1);
    color: var(--text-mid);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .hero-community-photo {
    min-width: 0;
    border: 2px solid var(--black);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--pink);
  }

  .hero-community-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s6);
  }

  .btn-hero {
    min-height: 46px;
    justify-content: center;
    padding: var(--s3) var(--s4);
    border-width: 2px;
    font-size: var(--text-sm);
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-hero.btn-primary {
    background: color-mix(in srgb, var(--pink) 92%, var(--black));
    color: var(--bg-white);
  }

  .btn-hero:hover {
    transform: none;
    box-shadow: none;
  }

  .btn-hero > span {
    display: inline-block;
    transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-hero:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 4px;
  }

  .btn-hero:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero:hover {
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-sm);
    }

    .btn-hero:hover > span {
      transform: translate(2px, -2px);
    }

    .btn-hero:active {
      transform: scale(0.97);
    }
  }

  .hero-video-wrap {
    margin-inline: var(--pad);
    margin-bottom: var(--s9);
    border: 4px solid var(--black);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: 8px 8px 0 var(--pink);
  }

  .hero-video-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--s3) var(--s5);
    background: var(--yellow);
    border-bottom: 4px solid var(--black);
  }

  .hero-video-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--black);
  }

  .hero-video-live {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--pink);
    letter-spacing: 0.06em;
  }

  .hero-video iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    display: block;
  }

  @media (max-width: 800px) {
    .hero-top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s6);
      margin-bottom: var(--s7);
    }

    .hero-headline {
      max-width: 18ch;
      font-size: clamp(36px, 7vw, var(--text-4xl));
    }

    .hero-community-photo img {
      aspect-ratio: 1100 / 734;
    }
  }

  @media (max-width: 480px) {
    .hero-invitation {
      font-size: var(--text-lg);
    }

    .hero-ctas {
      flex-direction: column;
    }

    .btn-hero {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-hero, .btn-hero > span {
      transition: none;
      transform: none !important;
    }
  }
</style>
