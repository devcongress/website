---
interface Props {
  purchaseIntentId: string;
  fallbackPath: string;
}

const { purchaseIntentId, fallbackPath } = Astro.props;
---

<div
  class="donation-checkout-runtime"
  data-donation-checkout-config
  data-purchase-intent-id={purchaseIntentId}
  data-fallback-path={fallbackPath}
>
  <p role="status" aria-live="polite" aria-atomic="true" data-donation-checkout-status></p>
</div>

<style is:inline>
  .donation-checkout-runtime {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  body > .navbar,
  body > main,
  body > .footer {
    transition: filter 180ms ease;
  }

  body.donation-checkout-open > .navbar,
  body.donation-checkout-open > main,
  body.donation-checkout-open > .footer {
    filter: blur(10px);
  }

  @media (prefers-reduced-motion: reduce) {
    body > .navbar,
    body > main,
    body > .footer {
      transition: none;
    }
  }
</style>

<script>
  import { initializeDonationCheckout } from '../lib/donation-checkout';

  initializeDonationCheckout();
</script>
