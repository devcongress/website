---
import type { WebsiteEvent } from '../lib/events';
import { getEventCardAction } from '../lib/event-card-actions';
import { withHomepageEventContext } from '../lib/event-navigation';
import { EVENT_SUBMISSIONS_ENABLED } from '../lib/features';

interface Props { events: WebsiteEvent[]; }
const { events } = Astro.props;

function getMeetupStatus(start: string, end: string) {
  const now = new Date();
  const s   = new Date(start);
  const e   = new Date(end);
  return now < s ? 'upcoming' : now <= e ? 'live' : 'past';
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const sorted = [...events]
  .sort((a, b) => new Date(b.startsAt).getTime() - new Date(a.startsAt).getTime())
  .map((m) => ({
    ...m,
    status: getMeetupStatus(m.startsAt, m.endsAt),
  }));

const recent  = sorted.slice(0, 3);

const statusConfig = {
  upcoming: { label: 'Upcoming' },
  live:     { label: '● Live' },
  past:     { label: 'Past' },
};
---

<section class="section" id="events">
  <div class="container">

    <div class="meetups-header">
      <span class="eyebrow">Events</span>
      <div class="meetups-title-row">
        <h2 class="heading-serif meetups-heading">Where we show up</h2>
        <div class="meetups-actions">
          <a href="/events/" class="btn btn-outline meetups-all-btn">
            All Events →
          </a>
          {EVENT_SUBMISSIONS_ENABLED && (
            <a href="/events/submit/" class="btn btn-primary meetups-submit-btn">
              Submit an event <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Recent: horizontal scroll row, always visible -->
    <div class="scroll-outer">
      <ul class="meetups-scroll" data-home-events-grid>
        {recent.map((event) => {
          const cfg = statusConfig[event.status];
          const detailsUrl = event.detailsUrl ? withHomepageEventContext(event.detailsUrl) : '/events/';
          const detailsExternal = detailsUrl.startsWith('http');
          const directAction = getEventCardAction(event, event.status);
          const actionExternal = directAction?.href.startsWith('http');
          return (
            <li class="meetup-card card has-detail-link">
              <a
                href={detailsUrl}
                class="meetup-card-detail-link"
                aria-label={`View details for ${event.title}`}
                target={detailsExternal ? '_blank' : undefined}
                rel={detailsExternal ? 'noopener noreferrer' : undefined}
              ></a>
              <div class="meetup-cover">
                {event.coverUrl && <img class="meetup-cover-image" src={event.coverUrl} alt="" loading="lazy" decoding="async" />}
                <span class={`meetup-status-badge status-${event.status}`}>{cfg.label}</span>
              </div>
              <div class="meetup-body">
                <div class="meetup-meta">
                  <time datetime={event.startsAt}>{formatDate(event.startsAt)}</time>
                  <span class="meetup-location" title={event.venueName ?? event.locationType}>{event.venueName ?? event.locationType.replaceAll('_', ' ')}</span>
                </div>
                <h3 class="heading-serif meetup-name" title={event.title}>{event.title}</h3>
                <p class="meetup-desc">{event.summary}</p>
                {directAction && (
                  <div class="meetup-card-actions">
                    <a
                      href={directAction.href}
                      class="btn btn-primary meetup-cta"
                      target={actionExternal ? '_blank' : undefined}
                      rel={actionExternal ? 'noopener noreferrer' : undefined}
                    >
                      {directAction.label}
                    </a>
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </div>



  </div>
</section>

<script>
  import { fetchLivePublicEvents } from '../lib/live-public-events';
  import { getEventCardAction } from '../lib/event-card-actions';
  import { withHomepageEventContext } from '../lib/event-navigation';

  const grid = document.querySelector('[data-home-events-grid]');
  const statusConfig = {
    upcoming: { label: 'Upcoming' },
    live: { label: '● Live' },
    past: { label: 'Past' },
  };

  function getStatus(start, end) {
    const now = Date.now();
    const startTime = new Date(start).getTime();
    const endTime = new Date(end).getTime();
    return now < startTime ? 'upcoming' : now <= endTime ? 'live' : 'past';
  }

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function render(events) {
    if (!(grid instanceof HTMLUListElement)) return;
    grid.replaceChildren();
    [...events]
      .sort((left, right) => new Date(right.startsAt).getTime() - new Date(left.startsAt).getTime())
      .slice(0, 3)
      .forEach((event) => {
        const status = getStatus(event.startsAt, event.endsAt);
        const config = statusConfig[status];
        const detailsUrl = event.detailsUrl ? withHomepageEventContext(event.detailsUrl) : '/events/';
        const directAction = getEventCardAction(event, status);
        const card = document.createElement('li');
        card.className = 'meetup-card card has-detail-link';

        const detailLink = document.createElement('a');
        detailLink.href = detailsUrl;
        detailLink.className = 'meetup-card-detail-link';
        detailLink.setAttribute('aria-label', `View details for ${event.title}`);
        applyExternalLinkAttributes(detailLink, detailsUrl);
        const cover = document.createElement('div');
        cover.className = 'meetup-cover';
        if (event.coverUrl) {
          const image = document.createElement('img');
          image.className = 'meetup-cover-image';
          image.src = event.coverUrl;
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          cover.append(image);
        }
        const statusBadge = document.createElement('span');
        statusBadge.className = `meetup-status-badge status-${status}`;
        statusBadge.textContent = config.label;
        cover.append(statusBadge);

        const body = document.createElement('div');
        body.className = 'meetup-body';
        const meta = document.createElement('div');
        meta.className = 'meetup-meta';
        const date = document.createElement('time');
        date.dateTime = event.startsAt;
        date.textContent = formatDate(event.startsAt);
        const location = document.createElement('span');
        location.className = 'meetup-location';
        location.title = event.venueName ?? event.locationType;
        location.textContent = event.venueName ?? event.locationType.replaceAll('_', ' ');
        meta.append(date, location);

        const title = document.createElement('h3');
        title.className = 'heading-serif meetup-name';
        title.title = event.title;
        title.textContent = event.title;

        const description = document.createElement('p');
        description.className = 'meetup-desc';
        description.textContent = event.summary;
        body.append(meta, title, description);
        if (directAction) {
          const actions = document.createElement('div');
          actions.className = 'meetup-card-actions';
          const cta = document.createElement('a');
          cta.href = directAction.href;
          cta.className = 'btn btn-primary meetup-cta';
          cta.textContent = directAction.label;
          applyExternalLinkAttributes(cta, directAction.href);
          actions.append(cta);
          body.append(actions);
        }
        card.append(detailLink, cover, body);
        grid.append(card);
      });
  }

  function applyExternalLinkAttributes(element, url) {
    if (url.startsWith('http')) {
      element.target = '_blank';
      element.rel = 'noopener noreferrer';
    }
  }

  void fetchLivePublicEvents().then(render).catch(() => undefined);
</script>


<style>
  .meetups-header {
    margin-bottom: var(--s7);
    display: flex;
    flex-direction: column;
    gap: var(--s2);
  }

  .meetups-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    flex-wrap: wrap;
  }

  .meetups-heading { font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl)); }

  .meetups-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s3);
    flex-wrap: wrap;
  }

  .meetups-actions .btn { flex-shrink: 0; }
  .meetups-submit-btn {
    width: max-content;
    padding-inline: var(--s4);
  }

  /* ── Horizontal scroll row ─────────────────────────────── */
  .scroll-outer {
    overflow-x: auto;
    overflow-y: visible;
    /* hide scrollbar visually but keep it functional */
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-inline: calc(-1 * var(--pad));
    padding-inline: var(--pad);
    /* bottom padding so box-shadow isn't clipped */
    padding-bottom: var(--s3);
  }
  .scroll-outer::-webkit-scrollbar { display: none; }

  .meetups-scroll {
    display: flex;
    gap: var(--s5);
    /* exactly 3 cards on desktop */
    width: max-content;
  }

  .meetups-scroll .meetup-card {
    /* desktop: exactly 1/3 of container minus gaps */
    width: calc((min(var(--max-w), 100vw) - 2 * var(--pad) - 2 * var(--s5)) / 3);
    flex-shrink: 0;
  }

  /* tablet: ~2 cards visible */
  @media (max-width: 900px) {
    .meetups-scroll .meetup-card {
      width: calc((100vw - 2 * var(--pad) - var(--s5)) / 2);
    }
  }

  /* mobile: 1.5 cards visible — scroll hint */
  @media (max-width: 600px) {
    .meetups-scroll .meetup-card {
      width: 85vw;
    }
  }


  /* ── Shared card styles ────────────────────────────────── */
  .meetup-card { position: relative; overflow: hidden; display: flex; flex-direction: column; }
  .meetup-card.has-detail-link { cursor: pointer; }
  .meetup-card-detail-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .meetup-card-detail-link:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: -5px;
  }

  .meetup-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--border-light);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: var(--s3);
  }
  .meetup-cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 160ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .meetup-status-badge { position: relative; }
  @media (hover: hover) and (pointer: fine) {
    .meetup-card:hover { transform: none; }
    .meetup-card:hover .meetup-cover-image { opacity: 0.92; }
  }

  .meetup-status-badge {
    font-size: var(--text-xs);
    font-weight: 700;
    border: 2px solid var(--black);
    border-radius: var(--r-sm);
    padding: 2px var(--s2);
  }
  .status-upcoming { background: var(--yellow);   color: var(--black); }
  .status-live     { background: var(--pink);     color: #fff; }
  .status-past     { background: var(--bg-white); color: var(--text-muted); }

  .meetup-body {
    padding: var(--s5);
    display: flex;
    flex-direction: column;
    gap: var(--s3);
    flex: 1;
    border-top: 2px solid var(--black);
  }

  .meetup-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .meetup-location {
    min-width: 0;
    width: 22ch;
    max-width: 50%;
    overflow: hidden;
    flex: 0 1 22ch;
    color: var(--pink);
    text-align: right;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meetup-name {
    min-width: 0;
    overflow: hidden;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meetup-desc {
    font-size: var(--text-sm);
    color: var(--text-mid);
    line-height: var(--leading-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .meetup-card-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: auto;
    pointer-events: none;
  }
  .meetup-card-actions .meetup-cta { align-self: auto; margin-top: 0; pointer-events: auto; }

  @media (prefers-reduced-motion: reduce) {
    .meetup-cover-image { transition: none; }
  }
</style>
