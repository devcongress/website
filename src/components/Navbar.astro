---
interface Props {
  slackUrl: string;
  paystackUrl: string;
}

const { slackUrl, paystackUrl } = Astro.props;
const conference = Astro.url.pathname.startsWith('/devcon26/');
const guardNavigation = Astro.url.pathname.replace(/\/$/, '') === '/events/submit';
const links = conference ? [
  { href: '/devcon26/#about', label: 'About' },
  { href: '/devcon26/#the-day', label: 'The day' },
  { href: '/devcon26/#speakers', label: 'Speakers' },
  { href: '/devcon26/#tickets', label: 'Register' },
  { href: '/devcon26/#faqs', label: 'FAQs' },
] : [
  { href: '/#community', label: 'Community' },
  { href: '/#programs', label: 'Programs' },
  { href: '/#events', label: 'Events' },
  { href: '/devcon26/', label: 'DevCon26' },
];
---

<header class="navbar" data-site-navbar>
  <div class="navbar-inner">
    <a href="/" class="navbar-logo" aria-label="DevCongress home" data-confirm-navigation={guardNavigation || undefined}>
      <img src="/images/logo.png" alt="DevCongress" height="32" />
    </a>
    <nav class="navbar-links" aria-label={conference ? 'DevCon26 sections' : 'Primary'}>
      {links.map((link) => (
        <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined} data-confirm-navigation={guardNavigation || undefined}><span class="nav-link-label">{link.label}</span></a>
      ))}
    </nav>
    <div class="navbar-actions">
      <a href={paystackUrl} target="_blank" rel="noopener noreferrer" class="nav-button nav-support">Support Us</a>
      <a href={slackUrl} target="_blank" rel="noopener noreferrer" class="nav-button nav-slack">Join Slack</a>
    </div>
    <button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="site-mobile-menu" aria-hidden="true" inert>
    <nav aria-label={conference ? 'DevCon26 mobile sections' : 'Mobile navigation'}>
      {links.map((link) => (
        <a href={link.href} aria-current={Astro.url.pathname === link.href ? 'page' : undefined} data-confirm-navigation={guardNavigation || undefined}><span class="nav-link-label">{link.label}</span><span aria-hidden="true">↗</span></a>
      ))}
    </nav>
    <div class="mobile-actions">
      <a href={paystackUrl} target="_blank" rel="noopener noreferrer" class="nav-button nav-support">Support Us</a>
      <a href={slackUrl} target="_blank" rel="noopener noreferrer" class="nav-button nav-slack">Join Slack</a>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 2px solid var(--black);
  }

  .navbar-inner {
    width: min(100%, 1280px);
    min-height: 76px;
    margin-inline: auto;
    padding-inline: clamp(20px, 3vw, 40px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 32px;
  }

  .navbar-logo {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 44px;
  }

  .navbar-logo img {
    width: auto;
    height: 32px;
  }

  .navbar-links, .navbar-actions {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .navbar-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-mid);
    white-space: nowrap;
  }

  .navbar-links a[aria-current='page'] {
    color: var(--pink);
  }

  .nav-link-label {
    position: relative;
    line-height: 1.2;
  }

  .nav-link-label::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -3px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar a:focus-visible .nav-link-label::after {
    transform: scaleX(1);
    transition: none;
  }

  .navbar-actions {
    justify-self: end;
    gap: 10px;
  }

  .nav-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 10px 18px;
    border: 2px solid var(--black);
    border-radius: var(--r-full);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-support {
    color: var(--text);
    background: transparent;
  }

  .nav-slack {
    color: white;
    background: var(--pink);
  }

  .navbar :is(a, button):focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 4px;
  }

  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border: 1px solid var(--border-light);
    border-radius: 8px;
    transition: transform 120ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-toggle span {
    width: 20px;
    height: 2px;
    background: var(--black);
    transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-button:active, .nav-toggle:active {
    transform: scale(0.97);
  }

  .mobile-menu {
    display: none;
  }

  @media print {
    .navbar {
      display: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .navbar-links a:hover, .mobile-menu nav a:hover {
      color: var(--pink);
    }

    .navbar a:hover .nav-link-label::after {
      transform: scaleX(1);
    }

    .nav-button:hover {
      transform: translateY(-1px);
    }
  }

  @media (max-width: 1100px) {
    .navbar-inner {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      min-height: 68px;
      padding-block: 12px;
    }

    .navbar-logo img {
      height: 28px;
    }

    .navbar-links {
      flex-wrap: wrap;
      gap: 8px 20px;
    }

    .navbar[data-ready] .navbar-inner {
      flex-wrap: nowrap;
    }

    .navbar[data-ready] :is(.navbar-links, .navbar-actions) {
      display: none;
    }

    .navbar[data-ready] .nav-toggle {
      display: flex;
      margin-left: auto;
    }

    .navbar[data-ready] .mobile-menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      padding: 20px clamp(20px, 3vw, 40px) 24px;
      max-height: calc(100dvh - 70px);
      overflow-y: auto;
      overscroll-behavior: contain;
      background: var(--bg);
      border-bottom: 2px solid var(--black);
      box-shadow: 0 12px 20px rgb(17 17 17 / 8%);
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      transition: opacity 180ms cubic-bezier(0.16, 1, 0.3, 1), transform 180ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 180ms;
    }

    .navbar[data-open='true'] .mobile-menu {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }

    .mobile-menu nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      color: var(--text);
      font-size: 18px;
      font-weight: 600;
    }

    .mobile-menu nav span[aria-hidden='true'] {
      color: var(--pink);
    }

    .mobile-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 16px;
      padding-top: 20px;
      border-top: 1px solid var(--border-light);
    }
  }

  @media (max-width: 359px) {
    .mobile-actions {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link-label::after {
      transition: none;
    }

    .navbar :is(.mobile-menu, .nav-toggle, .nav-toggle span, .nav-button) {
      transition: none;
    }

    .nav-button:is(:hover, :active), .nav-toggle:active {
      transform: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-navbar]');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = header?.querySelector<HTMLElement>('.mobile-menu');

  if (header && toggle && menu) {
    const mobile = window.matchMedia('(max-width: 1100px)');

    const setOpen = (requested: boolean) => {
      const open = requested && mobile.matches;

      header.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', String(!open));
      menu.inert = !open;
    };

    setOpen(false);
    header.dataset.ready = 'true';

    toggle.addEventListener('click', () => setOpen(header.dataset.open !== 'true'));

    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.dataset.open === 'true') {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });

    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setOpen(false);
    });

    mobile.addEventListener('change', () => {
      const hadFocus = header.contains(document.activeElement);

      setOpen(false);

      if (hadFocus) {
        const target = mobile.matches ? toggle : header.querySelector<HTMLElement>('.navbar-links a');

        target?.focus({ preventScroll: true });
      }
    });
  }
</script>
