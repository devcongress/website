---
import { EVENT_SUBMISSION_TURNSTILE_SITE_KEY } from '../../lib/events';
import Base from '../../layouts/Base.astro';
import '../../styles/devcon26-flexible-checkout.css';
import '../../styles/devcon26-checkout-design.css';

const completeTest = import.meta.env.PUBLIC_DEVCON26_COMPLETE_TEST === 'true';
const apiOrigin = import.meta.env.PUBLIC_DEVCON26_API_ORIGIN || 'https://em.devcongress.org';
---

<Base title="Choose your DevCon26 tickets | DevCongress" description="Choose how many DevCon26 tickets you need and who they are for." noindex={true} showFooter={false}>
  <a slot="skip-link" class="skip-link" href="#checkout-main">Skip to checkout</a>

  <main id="checkout-main" class="flexible-checkout checkout-design" data-flexible-checkout data-api-origin={apiOrigin} data-complete-test={completeTest ? "true" : "false"}>
    <div class="checkout-shell">
      <header class="checkout-header">
        <p class="eyebrow">DevCon26 / Registration</p>
        <h1>See you at <em>DevCon26.</em></h1>
        <p>Your ticket. Your community. A day of building what’s next.</p>
      </header>

      <section class="checkout-card checkout-availability" data-availability aria-live="polite" aria-atomic="true">
        <h2 data-availability-heading>Checking ticket availability…</h2>
        <p data-availability-message>We’re checking prices and whether checkout is ready.</p>
        <button class="retry-action" data-retry type="button" hidden>Check availability again</button>
      </section>

      <div class="checkout-layout" data-checkout-layout hidden>
        <aside class="order-summary" aria-labelledby="summary-heading">
          <div class="summary-event">
            <div class="ticket-brand-copy">
              <span class="ticket-overline">Your next connection</span>
              <span class="summary-event-brand">DevCon<span>26</span></span>
              <span class="summary-event-label">A gathering of builders.</span>
            </div>
            <svg class="ticket-illustration" viewBox="0 0 160 160" aria-hidden="true">
              <defs>
                <clipPath id="ticket-art-mask"><path d="M80 4a70 70 0 0 1 70 70v82H10V74A70 70 0 0 1 80 4Z" /></clipPath>
              </defs>
              <g clip-path="url(#ticket-art-mask)">
                <path fill="#f8b8d7" d="M0 0h160v160H0z" />
                <circle cx="119" cy="35" r="22" fill="#fff7b5" />
                <path fill="#e8117f" d="M0 120 160 78v82H0Z" />
                <path fill="#fff8df" d="M25 160V68h84v92H87v-54H47v54Z" />
                <path fill="#d6cbb0" d="m109 68 15 12v80h-15Z" />
                <path fill="#1c1c1c" d="m67 45 3 9 10 .2-8 6 3 9-8-5.5-8 5.5 3-9-8-6 10-.2Z" />
                <path fill="#f5e642" d="m8 130 32-12 7 42H8ZM134 114l26 9v37h-26Z" />
                <path d="m49 86 10-6m17 0 10 6m-37 0 10 6m17 0 10-6" fill="none" stroke="#1c1c1c" stroke-width="2" stroke-linecap="round" />
              </g>
            </svg>
          </div>
          <div class="summary-body">
            <p class="eyebrow">19 December 2026 · Accra</p>
            <h2 id="summary-heading">Order preview <span class="ticket-destination">ACC / 26</span></h2>
            <p class="summary-venue">Ghana Digital Center<br />Saturday, 19 December 2026</p>
            <dl><div><dt>Tickets</dt><dd data-summary-quantity>1</dd></div><div><dt>Price per ticket</dt><dd data-unit-price>Confirming…</dd></div><div class="summary-total"><dt>Ticket total</dt><dd data-total>—</dd></div></dl>
            <div class="step-context" data-step-context>
              <p class="context-label" data-context-label>Your ticket choices</p>
              <p class="context-description" data-context-description>Choose how each place will be used.</p>
              <ul data-context-items></ul>
            </div>
            <small>{completeTest ? "Preview: test payments, real emails. Tickets are not valid for admission." : "Your payment record confirms the charge. Ticket access and handoff details follow the choices you make above."}</small>
          </div>
        </aside>

        <form class="checkout-form" data-live-form novalidate>
          <div class="checkout-panel">
            <nav class="checkout-progress" aria-label="Checkout progress">
              <ol>
                <li><button type="button" data-step-link="0" aria-current="step"><span aria-hidden="true">01</span>Tickets</button></li>
                <li><button type="button" data-step-link="1" disabled><span aria-hidden="true">02</span>Your details</button></li>
                <li><button type="button" data-step-link="2" disabled><span aria-hidden="true">03</span>Payment</button></li>
              </ol>
            </nav>
            <section class="form-section ticket-section" data-checkout-step="0" aria-labelledby="quantity-heading">
              <div class="form-section-heading">
                <div>
                  <p class="section-kicker"><span aria-hidden="true">01</span> Tickets</p>
                  <h2 id="quantity-heading" tabindex="-1">How many are joining?</h2>
                </div>
                <p>One ticket per person.</p>
              </div>

              <div class="quantity-row">
                <div>
                  <span class="control-label">Individual ticket</span>
                  <p class="field-note" data-quantity-limit>Checking ticket availability…</p>
                </div>
                <div class="quantity-control">
                  <button type="button" data-decrease aria-label="Remove one ticket" disabled>−</button>
                  <label class="visually-hidden" for="ticket-quantity">Number of tickets</label>
                  <input id="ticket-quantity" data-quantity type="number" min="1" step="1" value="1" inputmode="numeric" disabled required />
                  <button type="button" data-increase aria-label="Add one ticket" disabled>+</button>
                </div>
              </div>

              <div class="allocation-heading">
                <h3 id="allocation-heading">Who are they for?</h3>
                <p>Choose how you’d like to use each ticket.</p>
              </div>
              <div class="allocation-list" data-allocation-list aria-labelledby="allocation-heading"></div>
              <div class="step-actions"><button class="primary-action" type="button" data-step-next>Continue to your details <span aria-hidden="true">→</span></button></div>
            </section>

            <section class="form-section" data-checkout-step="1" hidden aria-labelledby="buyer-heading">
              <div class="form-section-heading">
                <div>
                  <p class="section-kicker"><span aria-hidden="true">02</span> Contact</p>
                  <h2 id="buyer-heading" tabindex="-1">Your details</h2>
                </div>
                <p>Your order confirmation goes here.</p>
              </div>
              <div class="buyer-fields">
                <div class="field"><label for="purchaser-name">Full name</label><input id="purchaser-name" data-name type="text" autocomplete="name" maxlength="120" required disabled /></div>
                <div class="field"><label for="purchaser-email">Email address</label><input id="purchaser-email" data-email type="email" autocomplete="email" maxlength="254" required disabled /></div>
              </div>
              <div class="step-actions">
                <button class="step-back" type="button" data-step-back>Back</button>
                <button class="primary-action" type="button" data-step-next>Review your order <span aria-hidden="true">→</span></button>
              </div>
            </section>

            <section class="form-section payment-section" data-checkout-step="2" hidden aria-labelledby="payment-heading">
              <div class="payment-heading">
                <div>
                  <p class="section-kicker"><span aria-hidden="true">03</span> Payment</p>
                  <h2 id="payment-heading" tabindex="-1">You’re almost there</h2>
                </div>
                <div class="provider" data-provider hidden><span class="provider-mark" aria-hidden="true">✓</span><span data-provider-name>Paystack</span></div>
              </div>
              <p class="checkout-status" data-status role="status" aria-live="polite">Checking whether checkout is open…</p>
              {completeTest && <div class="cf-turnstile" data-checkout-challenge data-sitekey={EVENT_SUBMISSION_TURNSTILE_SITE_KEY}></div>}
              <button class="step-back" type="button" data-step-back>← Edit your details</button>
              <button class="primary-action" data-pay type="submit" disabled>Continue to payment <span aria-hidden="true">↗</span></button>
            </section>
          </div>
        </form>


      </div>

    </div>
  </main>
  {completeTest && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>}
</Base>

<script>
  import { initializeFlexibleCheckout } from '../../lib/devcon26-flexible-checkout';

  const page = document.querySelector<HTMLElement>('[data-flexible-checkout]');

  if (page) initializeFlexibleCheckout(page);
</script>
