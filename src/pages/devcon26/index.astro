---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const sectionLinks = [
  { href: '#about', label: 'About' },
  { href: '#the-day', label: 'The day' },
  { href: '#speakers', label: 'Speakers' },
  { href: '#tickets', label: 'Tickets' },
  { href: '#faqs', label: 'FAQs' },
];

const tickets = [
  {
    id: 'regular',
    name: 'Regular ticket',
    price: 'GHS 199.99',
    detail: 'One ticket for the day.',
    people: 'Just you. A whole community.',
    photo: '/images/devcon26/ticket-solo.webp',
  },
  {
    id: 'team-3',
    name: 'Team of 3',
    price: 'GHS 549.99',
    detail: 'Save GHS 49.98 together.',
    people: 'Bring your closest collaborators.',
    photo: '/images/devcon26/ticket-small-group.webp',
    featured: true,
  },
  {
    id: 'team-5',
    name: 'Team of 5',
    price: 'GHS 849.99',
    detail: 'Save GHS 149.96 together.',
    people: 'Make it a day for the team.',
    photo: '/images/devcon26/ticket-community.webp',
  },
];

const speakerSlots = ['01', '02', '03'];
const checkoutApiOrigin = import.meta.env.PUBLIC_DEVCON26_API_ORIGIN || 'https://em.devcongress.org';

const faqs = [
  ['Who is DevCon26 for?', 'For the people building technology across Africa: developers, designers, founders, product people, researchers, and students.'],
  ['When and where is it?', 'DevCon26 takes place in Accra in December 2026. The venue will be announced here once it is confirmed.'],
  ['Can I come with my team?', 'Yes. Team tickets cover three or five attendees, with an individual ticket issued to each person after purchase.'],
  ['Are tickets on sale now?', 'Not yet. The prices are published, and ticket sales will open here on DevCongress when the event is ready to sell.'],
];

const sponsorIds = new Set(['fido', 'kweku_tech', 'mest']);
const sponsors = (await getCollection('partners')).filter((partner) => sponsorIds.has(partner.id));
---

<Base title="DevCon26 | DevCongress" description="DevCon26 brings Africa’s builders together in Accra, Ghana in December 2026.">
  <div class="devcon-page" data-checkout-api-origin={checkoutApiOrigin}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header page-shell" data-devcon-header>
      <a href="/" class="brand" aria-label="DevCongress home">
        <img src="/images/logo.png" alt="dev:congress{};" width="154" height="36" />
        <span>DevCon26</span>
      </a>
      <nav class="section-nav" aria-label="DevCon26 sections">
        {sectionLinks.map((link) => (
          <a href={link.href}>
            {link.label}
            {link.href === '#tickets' && <span aria-hidden="true">↗</span>}
          </a>
        ))}
      </nav>
      <button class="section-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="devcon-section-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="mobile-section-nav" id="devcon-section-menu" aria-label="DevCon26 mobile sections" aria-hidden="true" inert>
        {sectionLinks.map((link) => (
          <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <section class="hero page-shell" aria-labelledby="event-title">
        <div class="hero-copy">
          <p class="event-label">DevCongress annual conference <span>2026</span></p>
          <h1 id="event-title">Good things<br />happen <em>in<br />good company.</em></h1>
          <p class="hero-summary">Get out from behind the screen. DevCon26 brings Ghana’s technology community together to share the hard parts, trade ideas, and find its next collaborators.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#tickets">Buy your tickets <span aria-hidden="true">↗</span></a>
            <p>December 2026<br /><strong>Accra, Ghana</strong></p>
          </div>
        </div>

        <div class="hero-images" aria-label="Moments from the DevCongress community">
          <figure class="hero-photo hero-photo-main">
            <img src="/images/devcon26/community-discussion.jpg" alt="People taking part in a DevCongress community discussion" width="1000" height="672" fetchpriority="high" />
          </figure>
          <figure class="hero-photo hero-photo-secondary">
            <img src="/images/devcon26/speaker-in-room.jpg" alt="A speaker presenting to an audience at a past DevCongress event" width="741" height="1000" />
          </figure>
          <span class="photo-note">Less scrolling.<br />More showing up.</span>
        </div>
      </section>

      <section id="about" class="story-section page-shell" aria-labelledby="story-title">
        <div class="story-heading">
          <span class="conversation-symbol" aria-hidden="true">↳</span>
          <h2 id="story-title">Come for the ideas.<br /><em>Stay for your people.</em></h2>
        </div>
        <div class="story-copy">
          <p>DevCongress has always been about what happens when people making things in the same city finally sit next to one another. DevCon26 makes more room for that, across disciplines, companies, and experience levels.</p>
          <p class="invitation">Whatever you’re building, there’s room for you.</p>
        </div>
        <div class="people-line" aria-label="Who DevCon26 is for">
          <span>Developers</span><span>Designers</span><span>Founders</span><span>Students</span><span class="people-you">& you.</span>
        </div>
      </section>

      <section id="the-day" class="day-section page-shell" aria-labelledby="day-title">
        <figure class="programme-photo">
          <img src="/images/devcon26/community-exchange.webp" alt="Two DevCongress attendees exchanging ideas during a community session" width="844" height="1000" loading="lazy" decoding="async" />
          <figcaption>Ideas land differently when you’re in the room.</figcaption>
        </figure>
        <div class="day-content">
          <p class="section-caption">Inside the day</p>
          <h2 id="day-title">The work<br />behind <em>the work.</em></h2>
          <p class="day-description">The honest question after a talk. The story you needed to hear. The person who’s been figuring out the same thing as you.</p>
          <p class="day-description">We’re shaping DevCon26 around useful stories and enough time to talk to the people in the room.</p>
          <aside class="programme-note">
            <span class="note-fold" aria-hidden="true">↗</span>
            <p class="section-caption">A note on the programme</p>
            <h3>Still taking shape.<br />Worth the wait.</h3>
            <p>Speakers, workshops, and sessions will be announced here as they are confirmed.</p>
          </aside>
        </div>
      </section>

      <section id="speakers" class="speakers-section page-shell" aria-labelledby="speakers-title">
        <div class="speakers-header">
          <h2 id="speakers-title">Fresh perspectives.<br /><em>Familiar challenges.</em></h2>
          <p>People with something useful to say. We’re putting the programme together with care; meet the speakers here as they are confirmed.</p>
        </div>
        <div class="speaker-grid">
          {speakerSlots.map((slot) => (
            <article class="speaker-card">
              <div class="speaker-placeholder" aria-hidden="true">
                <span class="speaker-number">{slot}</span>
                <svg class="speaker-art" viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {slot === '01' ? (
                    <>
                      <rect x="56" y="20" width="48" height="80" rx="24" />
                      <path d="M40 74v6a40 40 0 0 0 80 0v-6M80 120v20M60 140h40" />
                      <path d="M72 40h16M72 54h16" stroke-width="5" />
                    </>
                  ) : slot === '02' ? (
                    <>
                      <path d="M32 28h62a18 18 0 0 1 18 18v30a18 18 0 0 1-18 18H58l-26 22V94a18 18 0 0 1-18-18V46a18 18 0 0 1 18-18Z" />
                      <path d="M112 60h16a18 18 0 0 1 18 18v30a18 18 0 0 1-18 18v18l-24-18H82a18 18 0 0 1-18-18v-6" />
                      <path d="M40 60h44" stroke-width="5" />
                    </>
                  ) : (
                    <>
                      <path d="M20 70v20M40 52v56M60 32v96M80 20v120M100 42v76M120 58v44M140 72v16" />
                    </>
                  )}
                </svg>
                <small>Next voice, coming soon.</small>
              </div>
              <p class="speaker-status">Speaker announcement</p>
              <h3>To be announced</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="location-section page-shell" aria-labelledby="location-title">
        <div class="location-place" aria-label="Accra, Ghana">
          <span>Meet us in</span>
          <strong>Accra<span aria-hidden="true">.</span></strong>
          <span class="location-country">Ghana / December 2026</span>
        </div>
        <div class="location-copy">
          <h2 id="location-title">Built here.<br />Open to everyone.</h2>
          <p>Close to the people and communities making the city’s technology scene what it is. The venue will be shared here when confirmed.</p>
        </div>
      </section>

      <section id="tickets" class="tickets-section page-shell" aria-labelledby="tickets-title">
        <div class="section-intro">
          <div>
            <p class="section-caption">Your place in the room</p>
            <h2 id="tickets-title">Buy your <em>tickets.</em></h2>
          </div>
          <p>Come on your own or bring your team. These are the ticket prices for DevCon26. Sales haven’t opened yet.</p>
        </div>
        <div class="ticket-grid">
          {tickets.map((ticket) => (
            <article class:list={['ticket-card', { 'ticket-card-featured': ticket.featured }]}>
              <div class="ticket-illustration" aria-hidden="true">
                <img src={ticket.photo} alt="" width="640" height="512" loading="lazy" decoding="async" />
              </div>
              <div class="ticket-heading">
                <h3>{ticket.name}</h3>
                {ticket.featured && <span class="ticket-tag">Better together</span>}
              </div>
              <p class="ticket-people">{ticket.people}</p>
              <p class="ticket-price">{ticket.price}</p>
              <p class="ticket-detail">{ticket.detail}</p>
              <button
                class="ticket-buy-button"
                type="button"
                data-ticket-choice
                data-ticket-id={ticket.id}
                data-ticket-name={ticket.name}
                data-ticket-price={ticket.price}
                data-ticket-photo={ticket.photo}
                data-ticket-featured={ticket.featured ? 'true' : 'false'}
                aria-haspopup="dialog"
                disabled
              >
                Buy ticket <span aria-hidden="true">↗</span>
              </button>
            </article>
          ))}
        </div>
        <noscript><p class="ticket-fallback">Ticket sales have not opened yet. Enable JavaScript to preview your ticket selection.</p></noscript>
        <p class="ticket-sales-note">When sales open, you’ll check out right here on DevCongress.</p>
      </section>

      <section id="sponsors" class="sponsors-section page-shell" aria-labelledby="sponsors-title">
        <div class="sponsors-story">
          <span class="partner-symbol" aria-hidden="true">{'+ +'}</span>
          <p class="section-caption">The people behind the gathering</p>
          <h2 id="sponsors-title">Good company<br />needs <em>good backing.</em></h2>
          <p>Partners help keep this space open: a place for Ghana’s technology community to meet collaborators, exchange ideas, and take their work further.</p>
          <a class="button sponsor-button" href="mailto:hello@devcongress.org?subject=DevCon26%20partnership">
            Become a partner <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="sponsors-community">
          <p>With the support of</p>
          <ul class="sponsor-list" aria-label="DevCon26 partners">
            {sponsors.map((sponsor) => (
              <li class="sponsor-item">
                <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + sponsor.data.name}>
                  <span class="sponsor-name">{sponsor.data.name}</span>
                  <img
                    src={sponsor.data.logo}
                    alt=""
                    loading="lazy"
                    style={sponsor.data.backgroundColor ? 'background-color:' + sponsor.data.backgroundColor : undefined}
                  />
                  <span class="sponsor-visit" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="sponsors-signoff">A community gathering.<br />A collective effort.</p>
        </div>
      </section>

      <section id="faqs" class="faq-section page-shell" aria-labelledby="faq-title">
        <div class="faq-intro">
          <h2 id="faq-title">Before you<br /><em>show up.</em></h2>
          <p>A few things worth knowing.</p>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details class="faq-item" name="devcon26-faq">
              <summary>{question}<span aria-hidden="true">+</span></summary>
              <div class="faq-answer"><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </section>
    </main>

    <dialog class="checkout-dialog" id="ticket-checkout-dialog" aria-labelledby="checkout-title">
      <section class="checkout-panel">
        <div class="ticket-illustration" aria-hidden="true">
          <img src={tickets[0].photo} data-checkout-ticket-photo alt="" width="640" height="512" decoding="async" />
        </div>
        <form method="dialog" class="checkout-dismiss">
          <button type="submit" class="checkout-close" aria-label="Close ticket checkout">×</button>
        </form>
        <p class="section-caption">DevCon26 tickets</p>
        <h2 id="checkout-title">Your ticket choice.</h2>
        <div class="checkout-selection" aria-live="polite">
          <div>
            <p class="checkout-selection-label">Selected ticket</p>
            <p class="checkout-ticket-name" data-checkout-ticket-name>Regular ticket</p>
          </div>
          <p class="checkout-ticket-price" data-checkout-ticket-price>GHS 199.99</p>
        </div>
        <div class="checkout-notice" role="status" aria-live="polite">
          <p data-checkout-notice-title>Ticket sales haven’t opened yet.</p>
          <span data-checkout-notice-copy>Checking whether test checkout is available.</span>
        </div>
        <button class="checkout-payment-button" data-checkout-payment type="button" disabled aria-describedby="checkout-payment-note">Checking checkout…</button>
        <p id="checkout-payment-note" class="checkout-payment-note">Test mode only. No real money or admission ticket.</p>
      </section>
    </dialog>
  </div>
</Base>

<script>
  const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const page = document.querySelector('.devcon-page');
  const checkoutDialog = document.querySelector('#ticket-checkout-dialog');
  const checkoutTicketName = document.querySelector('[data-checkout-ticket-name]');
  const checkoutTicketPrice = document.querySelector('[data-checkout-ticket-price]');
  const checkoutTicketPhoto = document.querySelector('[data-checkout-ticket-photo]');
  const checkoutPayment = document.querySelector('[data-checkout-payment]');
  const checkoutNoticeTitle = document.querySelector('[data-checkout-notice-title]');
  const checkoutNoticeCopy = document.querySelector('[data-checkout-notice-copy]');
  const checkoutChoices = Array.from(document.querySelectorAll('[data-ticket-choice]'));
  const checkoutPath = '/api/public/annual-conference/2026/test-checkout';
  let checkoutTier = 'regular';
  let checkoutRequestKey;
  let checkoutReference;
  let checkoutAction = 'initialize';
  let checkoutBusy = false;
  let checkoutOperation = 0;
  let checkoutAbort;
  let checkoutCloseTimer;
  let checkoutTransition = 0;

  // This browser receives only public catalog/status data, never a provider key.
  async function checkoutApi(operation = '', body) {
    const api = new URL(page.dataset.checkoutApiOrigin);
    const local = ['localhost', '127.0.0.1', '[::1]'].includes(api.hostname);

    if ((api.protocol !== 'https:' && !(local && api.protocol === 'http:')) || api.username || api.password) {
      throw new Error('Checkout connection is not configured.');
    }
    const response = await fetch(new URL(checkoutPath + operation, api.origin), {
      method: body ? 'POST' : 'GET',
      credentials: 'omit',
      cache: 'no-store',
      headers: body ? { 'Content-Type': 'application/json' } : {},
      body: body ? JSON.stringify(body) : undefined,
      signal: checkoutAbort.signal,
    });
    const result = await response.json().catch(() => null);

    if (!response.ok || !result) throw new Error('Checkout is temporarily unavailable. Please try again.');

    return result;
  }

  function checkoutMessage(title, copy, label, disabled = false) {
    checkoutNoticeTitle.textContent = title;
    checkoutNoticeCopy.textContent = copy;
    checkoutPayment.textContent = label;
    checkoutPayment.disabled = disabled;
    checkoutPayment.setAttribute('aria-busy', String(checkoutBusy));
  }

  function beginCheckoutOperation() {
    checkoutAbort?.abort();
    checkoutAbort = new AbortController();
    checkoutBusy = true;

    return ++checkoutOperation;
  }

  async function checkCheckoutAvailability() {
    const operation = beginCheckoutOperation();

    checkoutMessage('Checking test checkout.', 'Live ticket sales remain closed.', 'Checking checkout…', true);

    try {
      const result = await checkoutApi();

      if (operation !== checkoutOperation) return;
      checkoutBusy = false;
      checkoutAction = 'initialize';
      const tier = result.tiers?.find((candidate) => candidate.tier_key === checkoutTier);

      if (result.mode !== 'test' || !tier || tier.currency !== 'GHS' || !Number.isSafeInteger(tier.amount_minor) || tier.amount_minor <= 0) {
        checkoutAction = 'availability';
        checkoutMessage('Test checkout isn’t enabled yet.', 'EMS needs the sandbox configuration and migration. Live ticket sales are still closed.', 'Check again');

        return;
      }
      checkoutTicketPrice.textContent = 'GHS ' + (tier.amount_minor / 100).toFixed(2);
      checkoutMessage('Paystack test checkout.', 'Try the payment flow using Paystack test details. This will not charge real money, reserve seats, or send a ticket.', 'Continue to test payment');
    } catch {
      if (operation !== checkoutOperation) return;
      checkoutBusy = false;
      checkoutAction = 'availability';
      checkoutMessage('We couldn’t connect to checkout.', 'Please try again. No payment has been started.', 'Check again');
    }
  }

  function selectCheckoutTicket(button) {
    checkoutTier = button.dataset.ticketId.replaceAll('-', '_');
    checkoutTicketName.textContent = button.dataset.ticketName || '';
    checkoutTicketPrice.textContent = button.dataset.ticketPrice || '';
    checkoutTicketPhoto.src = button.dataset.ticketPhoto;
    checkoutDialog.dataset.ticketFeatured = button.dataset.ticketFeatured || 'false';
  }

  function showCheckout() {
    window.clearTimeout(checkoutCloseTimer);
    const currentTransition = ++checkoutTransition;

    if (!checkoutDialog.open) checkoutDialog.showModal();
    window.requestAnimationFrame(() => {
      if (currentTransition === checkoutTransition && checkoutDialog.open) checkoutDialog.dataset.visible = 'true';
    });
  }

  async function verifyCheckoutReturn(reference) {
    const operation = beginCheckoutOperation();

    checkoutReference = reference;
    checkoutMessage('Verifying your test payment.', 'EMS is checking the result directly with Paystack.', 'Verifying…', true);

    try {
      const result = await checkoutApi('/verify', { reference });

      if (operation !== checkoutOperation) return;
      const button = checkoutChoices.find((candidate) => candidate.dataset.ticketId.replaceAll('-', '_') === result.tier_key);

      if (result.mode !== 'test' || !button || result.currency !== 'GHS' || !Number.isSafeInteger(result.amount_minor)) {
        throw new Error('Invalid checkout result.');
      }
      selectCheckoutTicket(button);
      checkoutTicketPrice.textContent = 'GHS ' + (result.amount_minor / 100).toFixed(2);
      checkoutBusy = false;
      checkoutAction = result.status === 'verified' ? 'done' : 'verify';

      if (result.status === 'verified') {
        checkoutMessage('Test checkout verified.', 'The test payment was confirmed by Paystack. No real money, admission ticket, seat reservation, or ticket email was created.', 'Done');
      } else if (result.status === 'pending') {
        checkoutMessage('Your test payment is still pending.', 'Paystack hasn’t confirmed success yet. You can check the result again.', 'Check payment status');
      } else if (result.status === 'failed') {
        checkoutMessage('Test payment wasn’t successful.', 'No successful payment was confirmed. Close this window to start a fresh test.', 'Check payment status');
      } else {
        throw new Error('Invalid checkout status.');
      }
    } catch {
      if (operation !== checkoutOperation) return;
      checkoutBusy = false;
      checkoutAction = 'verify';
      checkoutMessage('We couldn’t verify the test payment yet.', 'A return from Paystack alone doesn’t confirm success. Please check again.', 'Check payment status');
    }
  }

  checkoutPayment?.addEventListener('click', async () => {
    if (checkoutBusy) return;
    if (checkoutAction === 'done') return closeCheckout();
    if (checkoutAction === 'availability') return checkCheckoutAvailability();
    if (checkoutAction === 'verify') return verifyCheckoutReturn(checkoutReference);
    const operation = beginCheckoutOperation();

    checkoutMessage('Opening Paystack test checkout.', 'Use only Paystack test details on the next screen.', 'Opening Paystack…', true);

    try {
      checkoutRequestKey ||= crypto.randomUUID();
      const result = await checkoutApi('/initialize', { tier_key: checkoutTier, checkout_request_key: checkoutRequestKey });

      if (operation !== checkoutOperation) return;
      const destination = new URL(result.authorization_url);

      if (result.mode !== 'test' || destination.protocol !== 'https:' || destination.hostname !== 'checkout.paystack.com'
        || destination.username || destination.password || destination.port) throw new Error('Invalid payment destination.');
      window.location.assign(destination.href);
    } catch {
      if (operation !== checkoutOperation) return;
      checkoutBusy = false;
      checkoutMessage('Test checkout couldn’t start.', 'No payment was confirmed. Please try again shortly.', 'Try again');
    }
  });

  function closeCheckout() {
    if (!(checkoutDialog instanceof HTMLDialogElement) || !checkoutDialog.open) return;

    window.clearTimeout(checkoutCloseTimer);
    checkoutAbort?.abort();
    checkoutOperation += 1;
    checkoutBusy = false;
    checkoutTransition += 1;
    checkoutDialog.removeAttribute('data-visible');
    checkoutCloseTimer = window.setTimeout(() => checkoutDialog.close(), mediaQuery.matches ? 0 : 180);
  }

  if (checkoutDialog instanceof HTMLDialogElement && typeof checkoutDialog.showModal === 'function') {
    document.querySelectorAll('[data-ticket-choice]').forEach((button) => {
      button.disabled = false;
      button.addEventListener('click', () => {
        selectCheckoutTicket(button);
        checkoutRequestKey = undefined;
        checkoutReference = undefined;
        showCheckout();
        checkCheckoutAvailability();
      });
    });

    checkoutDialog.addEventListener('click', (event) => {
      if (event.target === checkoutDialog) closeCheckout();
    });

    checkoutDialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeCheckout();
    });

    checkoutDialog.querySelector('form').addEventListener('submit', (event) => {
      event.preventDefault();
      closeCheckout();
    });

    checkoutDialog.addEventListener('close', () => checkoutDialog.removeAttribute('data-visible'));

    const returnUrl = new URL(window.location.href);
    const returnedReference = returnUrl.searchParams.get('reference');

    if (returnUrl.searchParams.get('test_checkout') === 'return') {
      ['reference', 'trxref', 'test_checkout'].forEach((key) => returnUrl.searchParams.delete(key));
      window.history.replaceState(null, '', returnUrl.pathname + returnUrl.search + returnUrl.hash);
      showCheckout();
      verifyCheckoutReturn(returnedReference || '');
    }
  }

  const faqItems = Array.from(document.querySelectorAll('.faq-item'));
  const faqTimers = new WeakMap();
  let requestedFaq = null;
  let faqRequest = 0;

  page?.classList.add('has-faq-motion');

  function closeFaqItem(item) {
    window.clearTimeout(faqTimers.get(item));
    item.classList.remove('is-open');

    if (!item.open) return;

    faqTimers.set(item, window.setTimeout(() => {
      if (requestedFaq !== item) item.open = false;
    }, mediaQuery.matches ? 0 : 180));
  }

  faqItems.forEach((item) => {
    const summary = item.querySelector('summary');

    summary?.addEventListener('click', (event) => {
      event.preventDefault();

      requestedFaq = requestedFaq === item ? null : item;
      const currentRequest = ++faqRequest;

      faqItems.forEach((otherItem) => {
        if (otherItem !== requestedFaq) closeFaqItem(otherItem);
      });

      if (!requestedFaq) return;

      const selectedItem = requestedFaq;
      const anotherIsOpen = faqItems.some((otherItem) => otherItem !== selectedItem && otherItem.open);

      window.setTimeout(() => {
        if (currentRequest !== faqRequest) return;

        window.clearTimeout(faqTimers.get(selectedItem));
        selectedItem.open = true;
        window.requestAnimationFrame(() => {
          if (requestedFaq === selectedItem) selectedItem.classList.add('is-open');
        });
      }, anotherIsOpen && !mediaQuery.matches ? 180 : 0);
    });
  });
</script>

<script>
  const header = document.querySelector('[data-devcon-header]');
  const toggle = header?.querySelector('.section-menu-toggle');
  const menu = header?.querySelector('.mobile-section-nav');

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    const mobileNavigation = window.matchMedia('(max-width: 960px)');

    const setMenuOpen = (requestedOpen: boolean) => {
      const open = requestedOpen && mobileNavigation.matches;

      header.dataset.menuOpen = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.setAttribute('aria-hidden', String(!open));
      menu.inert = !open;
    };

    setMenuOpen(false);
    header.dataset.menuReady = 'true';

    toggle.addEventListener('click', () => {
      setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setMenuOpen(false);
        toggle.focus({ preventScroll: true });
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || toggle.getAttribute('aria-expanded') !== 'true') return;

      setMenuOpen(false);
      toggle.focus({ preventScroll: true });
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setMenuOpen(false);
    });

    mobileNavigation.addEventListener('change', () => {
      const desktopNavigation = header.querySelector('.section-nav');
      const navigationHadFocus = menu.contains(document.activeElement)
        || document.activeElement === toggle
        || desktopNavigation?.contains(document.activeElement);

      setMenuOpen(false);

      if (navigationHadFocus) {
        const focusTarget = mobileNavigation.matches ? toggle : header.querySelector('.section-nav a');

        if (focusTarget instanceof HTMLElement) focusTarget.focus({ preventScroll: true });
      }
    });
  }
</script>

