---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const sectionLinks = [
  { href: '#about', label: 'About' },
  { href: '#the-day', label: 'The day' },
  { href: '#speakers', label: 'Speakers' },
  { href: '#tickets', label: 'Tickets' },
  { href: '#faqs', label: 'FAQs' },
];

const tickets = [
  {
    id: 'regular',
    name: 'Regular ticket',
    price: 'GHS 199.99',
    detail: 'One ticket for the day.',
    people: 'Just you. A whole community.',
    photo: '/images/devcon26/ticket-solo.webp',
  },
  {
    id: 'team-3',
    name: 'Team of 3',
    price: 'GHS 549.99',
    detail: 'Save GHS 49.98 together.',
    people: 'Bring your closest collaborators.',
    photo: '/images/devcon26/ticket-small-group.webp',
    featured: true,
  },
  {
    id: 'team-5',
    name: 'Team of 5',
    price: 'GHS 849.99',
    detail: 'Save GHS 149.96 together.',
    people: 'Make it a day for the team.',
    photo: '/images/devcon26/ticket-community.webp',
  },
];

const speakerSlots = ['01', '02', '03'];
const heroScenes = [
  {
    label: 'The April community gathered together',
    main: { src: '/images/devcon26/hero-april-community.webp', alt: 'DevCongress members gathered outside for an April meetup group photo', width: 1000, height: 634 },
    secondary: { src: '/images/devcon26/hero-april-participant.webp', alt: 'A community member contributing to the April meetup discussion', width: 720, height: 779 },
  },
  {
    label: 'Community discussion and a speaker in the room',
    main: { src: '/images/devcon26/community-discussion.jpg', alt: 'People taking part in a DevCongress community discussion', width: 1000, height: 672 },
    secondary: { src: '/images/devcon26/speaker-in-room.jpg', alt: 'A speaker presenting to an audience at a past DevCongress event', width: 741, height: 1000 },
  },
  {
    label: 'The meetup community and a speaker sharing ideas',
    main: { src: '/images/devcon26/hero-community-group.webp', alt: 'DevCongress attendees gathered for a group photo after a meetup', width: 1100, height: 734 },
    secondary: { src: '/images/devcon26/hero-meetup-speaker.webp', alt: 'A DevCongress meetup speaker talking into a handheld microphone', width: 720, height: 480 },
  },
  {
    label: 'The April audience and a presenter',
    main: { src: '/images/devcon26/hero-april-audience.webp', alt: 'Community members listening together during the April DevCongress meetup', width: 1000, height: 633 },
    secondary: { src: '/images/devcon26/hero-april-presenter.webp', alt: 'A presenter standing beside a laptop and display at the April meetup', width: 720, height: 951 },
  },
  {
    label: 'A panel conversation and the people listening',
    main: { src: '/images/devcon26/hero-panel-discussion.webp', alt: 'Three panelists taking part in a DevCongress discussion', width: 1100, height: 734 },
    secondary: { src: '/images/devcon26/hero-meetup-audience.webp', alt: 'Attendees listening together during a DevCongress meetup', width: 720, height: 480 },
  },
  {
    label: 'Questions and conversations at the April meetup',
    main: { src: '/images/devcon26/hero-april-questions.webp', alt: 'An attendee raising a hand to contribute during the April meetup', width: 1000, height: 822 },
    secondary: { src: '/images/devcon26/hero-april-conversation.webp', alt: 'Two community members talking beside one another at the April meetup', width: 640, height: 925 },
  },
  {
    label: 'The May speakers and a host welcoming the community',
    main: { src: '/images/devcon26/hero-may-speakers.webp', alt: 'Four DevCongress speakers smiling together at the May meetup', width: 1100, height: 734 },
    secondary: { src: '/images/devcon26/hero-may-host.webp', alt: 'A meetup host speaking into a microphone in front of community photographs', width: 720, height: 480 },
  },
  {
    label: 'Connections and familiar faces at the May meetup',
    main: { src: '/images/devcon26/hero-may-connections.webp', alt: 'May meetup panelists chatting together before a session', width: 1100, height: 734 },
    secondary: { src: '/images/devcon26/hero-may-attendee.webp', alt: 'A smiling community member seated with the May meetup audience', width: 720, height: 480 },
  },
];

const heroSlots = [
  {
    name: 'gatherings',
    photos: heroScenes.map((scene, index) => ({
      ...scene.main,
      position: index === 0 ? '50% 80%' : '50% 55%',
    })),
  },
  {
    name: 'conversations',
    photos: [6, 0, 2, 4].map((index) => ({
      ...heroScenes[index].secondary,
      position: '50% 30%',
    })),
  },
  {
    name: 'ideas',
    photos: [1, 3, 5, 7].map((index) => ({
      ...heroScenes[index].secondary,
      position: '50% 30%',
    })),
  },
];

const checkoutApiOrigin = import.meta.env.PUBLIC_DEVCON26_API_ORIGIN || 'https://em.devcongress.org';

const faqs = [
  ['Who is DevCon26 for?', 'For the people building technology across Africa: developers, designers, founders, product people, researchers, and students.'],
  ['When and where is it?', 'Meet us at Ghana Digital Center (formerly Accra Digital Center), Accra, Ghana in December 2026. The exact date and programme will be announced here.'],
  ['Can I come with my team?', 'Yes. Choose a team of three or five, and bring your closest collaborators. Attendee and admission details are handled separately from the payment summary.'],
  ['How do I buy a ticket?', 'Choose a ticket below and continue to secure checkout with Paystack. You do not need a DevCongress or EMS account.'],
];

const sponsorIds = new Set(['kweku_tech']);
const partners = await getCollection('partners');
const sponsors = partners.filter((partner) => sponsorIds.has(partner.id));
const pastSponsors = [...partners].sort((left, right) => left.data.name.localeCompare(right.data.name, 'en', { sensitivity: 'base' }));

const sponsorshipPackages = [
  {
    id: 'contributor',
    name: 'Community Contributor',
    price: 'GHS 5,000',
    description: 'A little backing. A lasting connection.',
    highlights: ['Logo and company profile', 'Event and social recognition', 'Community job sharing'],
    qualification: 'No exhibition, speaking, or dedicated activations.',
    passes: '2 conference passes',
  },
  {
    id: 'collaborator',
    name: 'Community Collaborator',
    price: 'GHS 10,000',
    description: 'Get closer to the people making things happen.',
    highlights: ['Enhanced logo and screen placement', 'Jobs and graduate opportunities', 'Career connections with attendees'],
    qualification: 'No exhibition or stage opportunities.',
    passes: '4 conference passes',
  },
  {
    id: 'builder',
    name: 'Community Builder',
    price: 'GHS 20,000',
    description: 'Bring something useful into the room.',
    highlights: ['Standard exhibition and recruitment', '5-minute Speaker Spotlight', 'Workshop and demo opportunities'],
    qualification: 'Speaking and programme opportunities require DevCongress approval.',
    passes: '6 conference passes',
  },
  {
    id: 'catalyst',
    name: 'Community Catalyst',
    price: 'GHS 30,000',
    description: 'Make your presence part of the experience.',
    highlights: ['Premium exhibition and activation', '5-minute spotlight and stage opportunities', 'Sponsor interview and enhanced visibility'],
    qualification: 'Programme opportunities require DevCongress approval. Exhibition space and passes replace the previous tier’s allocation.',
    passes: '8 conference passes',
  },
  {
    id: 'champion',
    name: 'Community Champion',
    price: 'GHS 50,000',
    description: 'A major presence. A deeper community investment.',
    highlights: ['Premier branding and category exclusivity', '10-minute spotlight and stage opportunities', 'Premium exhibition and talent engagement'],
    qualification: 'Programme opportunities require DevCongress approval. Exclusivity is limited to the agreed category at this sponsorship level.',
    passes: '10 conference passes',
  },
  {
    id: 'title',
    name: 'Title Partner',
    price: 'GHS 70,000+',
    description: 'A partnership shaped around your ambition.',
    highlights: ['Potential title recognition', 'Tailored exhibition and activations', 'Proposed 15-minute featured spotlight'],
    qualification: 'Benefits are agreed individually. Programme opportunities require DevCongress approval.',
    passes: 'Conference passes tailored to your partnership',
  },
] as const;

function packageEnquiryLink(sponsorship: (typeof sponsorshipPackages)[number]) {
  const subject = 'DevCon26 ' + sponsorship.name + ' sponsorship enquiry';
  const body = [
    'Hi DevCongress team,',
    '',
    'We would like to proceed with the ' + sponsorship.name + ' sponsorship package at ' + sponsorship.price + '.',
    '',
    'Organisation: [Organisation name]',
    'Contact name: [Your name]',
    '',
    'Please share the next steps to confirm our sponsorship.',
  ].join('\r\n');

  return 'mailto:events@devcongress.org?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
}

---

<Base title="DevCon26 | DevCongress" description="DevCon26 brings Africa’s builders together in Accra, Ghana in December 2026.">
  <div class="devcon-page" data-checkout-api-origin={checkoutApiOrigin}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header page-shell" data-devcon-header>
      <a href="/" class="brand" aria-label="DevCongress home">
        <img src="/images/logo.png" alt="dev:congress{};" width="154" height="36" />
      </a>
      <nav class="section-nav" aria-label="DevCon26 sections">
        {sectionLinks.map((link) => (
          <a href={link.href}>
            {link.label}
            {link.href === '#tickets' && <span aria-hidden="true">↗</span>}
          </a>
        ))}
      </nav>
      <button class="section-menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="devcon-section-menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <nav class="mobile-section-nav" id="devcon-section-menu" aria-label="DevCon26 mobile sections" aria-hidden="true" inert>
        {sectionLinks.map((link) => (
          <a href={link.href}>{link.label}<span aria-hidden="true">→</span></a>
        ))}
      </nav>
    </header>

    <main id="main-content">
      <section class="hero page-shell" aria-labelledby="event-title">
        <div class="hero-copy">
          <p class="event-label">
            <span class="event-label-copy">DevCongress annual conference</span>
            <span class="event-year">2026</span>
          </p>
          <h1 id="event-title">A year together.<br /><em>One big gathering.</em></h1>
          <p class="hero-summary">Meetups, ideas, and new connections all year. Join the community at DevCon26.</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#tickets">Buy your tickets <span aria-hidden="true">↗</span></a>
            <p>December 2026<br /><strong>Ghana Digital Center (formerly Accra Digital Center), Accra</strong></p>
          </div>
        </div>

        <div class="hero-images" data-hero-slideshow role="group" aria-label="DevCongress gatherings throughout the year">
          {heroSlots.map((slot, slotIndex) => (
            <figure class:list={['hero-photo', { 'hero-photo-main': slotIndex === 0 }]} data-hero-slot={slot.name}>
              {slot.photos.map((photo, photoIndex) => (
                <img
                  class:list={{ 'is-active': photoIndex === 0 }}
                  src={photoIndex === 0 ? photo.src : undefined}
                  data-hero-src={photo.src}
                  alt={photo.alt}
                  aria-hidden={photoIndex !== 0 ? 'true' : undefined}
                  width={photo.width}
                  height={photo.height}
                  style={'object-position: ' + photo.position}
                  loading={photoIndex === 0 ? 'eager' : 'lazy'}
                  fetchpriority={slotIndex === 0 && photoIndex === 0 ? 'high' : 'auto'}
                  decoding="async"
                />
              ))}
            </figure>
          ))}
        </div>
      </section>

      <section id="about" class="story-section page-shell" aria-labelledby="story-title">
        <div class="story-heading">
          <span class="conversation-symbol" aria-hidden="true">↳</span>
          <h2 id="story-title">Come for the ideas.<br /><em>Stay for your people.</em></h2>
        </div>
        <div class="story-copy">
          <p>DevCongress has always been about what happens when people making things in the same city finally sit next to one another. DevCon26 makes more room for that, across disciplines, companies, and experience levels.</p>
          <p class="invitation">Whatever you’re building, there’s room for you.</p>
        </div>
        <div class="people-line" aria-label="Who DevCon26 is for">
          <span>Developers</span><span>Designers</span><span>Founders</span><span>Students</span><span class="people-you">& you.</span>
        </div>
      </section>

      <section id="the-day" class="day-section page-shell" aria-labelledby="day-title">
        <figure class="programme-photo">
          <img src="/images/devcon26/community-exchange.webp" alt="Two DevCongress attendees exchanging ideas during a community session" width="844" height="1000" loading="lazy" decoding="async" />
          <figcaption>Ideas land differently when you’re in the room.</figcaption>
        </figure>
        <div class="day-content">
          <p class="section-caption">Inside the day</p>
          <h2 id="day-title">The work<br />behind <em>the work.</em></h2>
          <p class="day-description">The honest question after a talk. The story you needed to hear. The person who’s been figuring out the same thing as you.</p>
          <p class="day-description">We’re shaping DevCon26 around useful stories and enough time to talk to the people in the room.</p>
          <aside class="programme-note">
            <span class="note-fold" aria-hidden="true">↗</span>
            <p class="section-caption">A note on the programme</p>
            <h3>Still taking shape.<br />Worth the wait.</h3>
            <p>Speakers, workshops, and sessions will be announced here as they are confirmed.</p>
          </aside>
        </div>
      </section>

      <section id="speakers" class="speakers-section page-shell" aria-labelledby="speakers-title">
        <div class="speakers-header">
          <h2 id="speakers-title">Fresh perspectives.<br /><em>Familiar challenges.</em></h2>
          <p>People with something useful to say. We’re putting the programme together with care; meet the speakers here as they are confirmed.</p>
        </div>
        <div class="speaker-grid">
          {speakerSlots.map((slot) => (
            <article class="speaker-card">
              <div class="speaker-placeholder" aria-hidden="true">
                <span class="speaker-number">{slot}</span>
                <svg class="speaker-art" viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  {slot === '01' ? (
                    <>
                      <rect x="56" y="20" width="48" height="80" rx="24" />
                      <path d="M40 74v6a40 40 0 0 0 80 0v-6M80 120v20M60 140h40" />
                      <path d="M72 40h16M72 54h16" stroke-width="5" />
                    </>
                  ) : slot === '02' ? (
                    <>
                      <path d="M32 28h62a18 18 0 0 1 18 18v30a18 18 0 0 1-18 18H58l-26 22V94a18 18 0 0 1-18-18V46a18 18 0 0 1 18-18Z" />
                      <path d="M112 60h16a18 18 0 0 1 18 18v30a18 18 0 0 1-18 18v18l-24-18H82a18 18 0 0 1-18-18v-6" />
                      <path d="M40 60h44" stroke-width="5" />
                    </>
                  ) : (
                    <>
                      <path d="M20 70v20M40 52v56M60 32v96M80 20v120M100 42v76M120 58v44M140 72v16" />
                    </>
                  )}
                </svg>
                <small>Next voice, coming soon.</small>
              </div>
              <p class="speaker-status">Speaker announcement</p>
              <h3>To be announced</h3>
            </article>
          ))}
        </div>
      </section>

      <section class="location-section page-shell" aria-labelledby="location-title">
        <div class="location-place" aria-label="Accra, Ghana">
          <span>Meet us in</span>
          <strong>Accra<span aria-hidden="true">.</span></strong>
          <span class="location-country">
            Ghana Digital Center
            <span class="location-former-name">(formerly Accra Digital Center)</span>
          </span>
        </div>
        <div class="location-copy">
          <h2 id="location-title">Built here.<br />Open to everyone.</h2>
          <p>Ghana Digital Center (formerly Accra Digital Center), Accra, Ghana. A place for the people and communities moving the city’s technology scene forward.</p>
          <a class="location-directions" href="https://www.google.com/maps/search/?api=1&query=Accra%20Digital%20Centre%2C%20Accra%2C%20Ghana" target="_blank" rel="noopener noreferrer">Find the venue <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </section>

      <section id="tickets" class="tickets-section page-shell" aria-labelledby="tickets-title">
        <div class="section-intro">
          <div>
            <p class="section-caption">Your place in the room</p>
            <h2 id="tickets-title">Buy your <em>tickets.</em></h2>
          </div>
          <p>Come on your own or bring your team. Choose your place in the room.</p>
        </div>
        <div class="ticket-grid">
          {tickets.map((ticket) => (
            <article class:list={['ticket-card', { 'ticket-card-featured': ticket.featured }]}>
              <div class="ticket-illustration" aria-hidden="true">
                <img src={ticket.photo} alt="" width="640" height="512" loading="lazy" decoding="async" />
              </div>
              <div class="ticket-heading">
                <h3>{ticket.name}</h3>
                {ticket.featured && <span class="ticket-tag">Better together</span>}
              </div>
              <p class="ticket-people">{ticket.people}</p>
              <p class="ticket-price">{ticket.price}</p>
              <p class="ticket-detail">{ticket.detail}</p>
              <button
                class="ticket-buy-button"
                type="button"
                data-ticket-choice
                data-ticket-id={ticket.id}
                data-ticket-name={ticket.name}
                data-ticket-price={ticket.price}
                data-ticket-photo={ticket.photo}
                data-ticket-featured={ticket.featured ? 'true' : 'false'}
                aria-haspopup="dialog"
                disabled
              >
                Buy ticket <span aria-hidden="true">↗</span>
              </button>
            </article>
          ))}
        </div>
        <noscript><p class="ticket-fallback">Enable JavaScript to choose a ticket and continue to checkout.</p></noscript>
        <p class="ticket-sales-note">Secure checkout with Paystack. No account needed.</p>
      </section>

      <section id="sponsors" class="sponsors-section page-shell" aria-labelledby="sponsors-title">
        <div class="sponsors-story">
          <p class="section-caption">The people behind the gathering</p>
          <h2 id="sponsors-title">Good company<br />needs <em>good backing.</em></h2>
          <p>Partners help keep this space open: a place for Ghana’s technology community to meet collaborators, exchange ideas, and take their work further.</p>
        </div>
        <div class="sponsors-community">
          <p>With the support of</p>
          <ul class="sponsor-list" aria-label="DevCon26 partners">
            {sponsors.map((sponsor) => (
              <li class="sponsor-item">
                <a href={sponsor.data.url} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + sponsor.data.name}>
                  <span class="sponsor-name">{sponsor.data.name}</span>
                  <img
                    src={sponsor.data.logo}
                    alt=""
                    loading="lazy"
                    style={sponsor.data.backgroundColor ? 'background-color:' + sponsor.data.backgroundColor : undefined}
                  />
                  <span class="sponsor-visit" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div class="sponsorship-packages" aria-labelledby="packages-title">
          <div class="packages-intro">
            <div>
              <p class="section-caption">Sponsorship packages</p>
              <h3 id="packages-title">Find your way to <em>get involved.</em></h3>
            </div>
            <a class="sponsorship-download" href="/downloads/devcon26-sponsorship-packages.pdf" download="DevCon26 Sponsorship Packages.pdf">
              Download sponsorship packages <span aria-hidden="true">↗</span>
              <small>PDF · Full benefits and terms</small>
            </a>
          </div>
          <div class="package-grid">
            {sponsorshipPackages.map((sponsorship) => (
              <article class="package-plan" aria-labelledby={'package-' + sponsorship.id}>
                <div class="package-heading">
                  <h4 id={'package-' + sponsorship.id}>
                    <span class="package-family">{sponsorship.id === 'title' ? 'Title' : 'Community'}</span>{' '}
                    <span class="package-tier">{sponsorship.name.replace(/^(Community|Title) /, '')}</span>
                  </h4>
                </div>
                <p class="package-price">
                  <span class="package-currency">GHS</span>{' '}
                  <span>{sponsorship.price.replace('GHS ', '')}</span>
                </p>
                <p class="package-description">{sponsorship.description}</p>
                <ul class="package-highlights">
                  {sponsorship.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
                <div class="package-allocation">
                  <p class="package-passes">{sponsorship.passes}</p>
                  <p class="package-qualification">{sponsorship.qualification}</p>
                </div>
                <a class="package-enquiry" href={packageEnquiryLink(sponsorship)}>
                  Choose this package <span aria-hidden="true">↗</span><span class="sr-only">: {sponsorship.name}</span>
                </a>
              </article>
            ))}
          </div>
          <div class="custom-sponsorship">
            <div>
              <p class="section-caption">Something more specific?</p>
              <h3>Let’s build a partnership <em>around your ideas.</em></h3>
              <p>Back a workshop, networking, recruitment, student access, refreshments, swag, or another part of the day. We prioritise cash sponsorships and consider selected in-kind contributions that support the event.</p>
            </div>
            <a class="button sponsor-button" href="mailto:events@devcongress.org?subject=DevCon26%20custom%20sponsorship%20enquiry">Discuss a custom partnership <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section id="faqs" class="faq-section page-shell" aria-labelledby="faq-title">
        <div class="faq-intro">
          <h2 id="faq-title">Before you<br /><em>show up.</em></h2>
          <p>A few things worth knowing.</p>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details class="faq-item" name="devcon26-faq">
              <summary>{question}<span aria-hidden="true">+</span></summary>
              <div class="faq-answer"><p>{answer}</p></div>
            </details>
          ))}
        </div>
      </section>
      <section class="past-sponsors-section page-shell" aria-labelledby="past-sponsors-title">
        <div class="past-sponsors-intro">
          <p class="section-caption">A history of good company</p>
          <h2 id="past-sponsors-title">Past <em>sponsors.</em></h2>
          <p>The organisations that have backed the DevCongress community along the way.</p>
        </div>
        <ul class="past-sponsors-list">
          {pastSponsors.map((partner) => (
            <li>
              <a href={partner.data.url} target="_blank" rel="noopener noreferrer" aria-label={'Visit ' + partner.data.name + ' (opens in a new tab)'}>
                <span class="past-sponsor-logo" style={partner.data.backgroundColor ? 'background-color:' + partner.data.backgroundColor : undefined}>
                  <img src={partner.data.logo} alt="" width="180" height="70" loading="lazy" decoding="async" />
                </span>
                <span>{partner.data.name}</span>
                <span class="past-sponsor-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <dialog class="checkout-dialog" id="ticket-checkout-dialog" aria-labelledby="checkout-title">
      <div class="checkout-surface" data-checkout-surface aria-hidden="true"></div>
      <div class="checkout-art" data-checkout-art aria-hidden="true">
        <div class="ticket-illustration" aria-hidden="true">
          <img src={tickets[0].photo} data-checkout-ticket-photo alt="" width="640" height="512" decoding="async" />
        </div>
      </div>
      <section class="checkout-panel">
        <div class="checkout-content" data-checkout-content>
          <form method="dialog" class="checkout-dismiss">
            <button type="submit" class="checkout-close" aria-label="Close ticket checkout">×</button>
          </form>
          <p class="section-caption">DevCon26 tickets</p>
          <h2 id="checkout-title">Your ticket choice.</h2>
          <div class="checkout-selection" aria-live="polite">
            <div>
              <p class="checkout-selection-label">Selected ticket</p>
              <p class="checkout-ticket-name" data-checkout-ticket-name>Regular ticket</p>
            </div>
            <p class="checkout-ticket-price" data-checkout-ticket-price>GHS 199.99</p>
          </div>
          <div class="checkout-notice" role="status" aria-live="polite">
            <p data-checkout-notice-title>Getting your checkout ready.</p>
            <span data-checkout-notice-copy>Checking availability for your ticket choice.</span>
          </div>
          <form class="checkout-buyer-form" data-checkout-buyer-form novalidate>
            <div class="checkout-buyer-fields">
