    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-heading);
    line-height: 1.2;
  }

  .ticket-detail {
    margin-top: 8px;
  }

  .ticket-buy-button {
    width: 100%;
    margin-top: 28px;
    background: var(--dc-paper-light);
    color: var(--dc-ink);
    box-shadow: inset 0 0 0 1px var(--dc-ticket-action-outline);
    cursor: pointer;
  }

  .ticket-buy-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ticket-buy-button span {
    color: var(--dc-pink);
  }

  .ticket-sales-note, .ticket-fallback {
    margin-top: 22px;
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
  }

  .sponsors-section {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    column-gap: 70px;
    row-gap: var(--s6);
    padding-block: 12px 30px;
  }

  .sponsors-story .section-caption {
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
  }

  .sponsors-story h2 {
    font-size: clamp(34px, 3.8vw, 50px);
    line-height: 1.06;
  }

  .sponsors-story h2 em {
    color: var(--dc-pink);
  }

  .sponsors-story > p:not(.section-caption) {
    margin-top: 25px;
    color: var(--dc-muted);
    font-size: var(--dc-text-body);
    line-height: 1.65;
  }

  .sponsor-button {
    margin-top: 26px;
    background: var(--dc-yellow);
    color: var(--dc-ink);
  }

  .sponsors-community {
    align-self: center;
  }

  .sponsors-community > p:first-child {
    margin-bottom: 18px;
    font-size: var(--dc-text-meta);
  }

  .sponsor-list {
    list-style: none;
  }

  .sponsor-item:not(:last-child) {
    border-bottom: 1px solid var(--dc-rule);
  }

  .sponsor-item a {
    display: grid;
    grid-template-columns: 1fr 110px 20px;
    align-items: center;
    gap: 18px;
    min-height: 100px;
  }

  .sponsor-name {
    font-size: clamp(20px, 2.1vw, 28px);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .sponsor-item img {
    width: 100%;
    max-width: 110px;
    max-height: 48px;
    padding: 6px;
    border-radius: 6px;
    background: var(--dc-paper-light);
    object-fit: contain;
    outline: 1px solid rgba(0, 0, 0, 0.1);
    outline-offset: -1px;
  }

  .sponsor-visit {
    color: var(--dc-pink);
    font-size: 22px;
    transition: transform 160ms var(--dc-ease);
  }

  .sponsorship-packages {
    grid-column: 1 / -1;
    min-width: 0;
    border-top: 1px solid var(--dc-rule);
  }

  .packages-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    justify-content: space-between;
    gap: var(--s6);
    padding-block: var(--s6);
  }

  .packages-intro .section-caption {
    margin-bottom: var(--s3);
  }

  .packages-intro h3 {
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(28px, 2.8vw, 36px);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1.2;
    text-wrap: balance;
  }

  .packages-intro h3 em, .custom-sponsorship h3 em, .past-sponsors-intro h2 em {
    color: var(--dc-pink);
  }

  .sponsorship-download {
    position: relative;
    isolation: isolate;
    display: inline-block;
    min-height: 44px;
    padding: var(--s4);
    border: 1px solid var(--dc-rule);
    border-radius: 8px;
    font-size: var(--dc-text-small);
    font-weight: 600;
    line-height: 1.5;
    transition: transform 160ms var(--dc-ease);
  }

  .sponsorship-download::before {
    position: absolute;
    inset: -1px;
    z-index: -1;
    border: 1px solid color-mix(in srgb, var(--dc-ink) 28%, transparent);
    border-radius: inherit;
    background: var(--dc-paper-light);
    box-shadow: 0 3px 8px rgb(0 0 0 / 0.04);
    opacity: 0;
    pointer-events: none;
    content: '';
    transition: opacity 160ms var(--dc-ease);
  }

  .sponsorship-download:is(:focus-visible, :active)::before {
    opacity: 1;
  }

  .sponsorship-download > span {
    display: inline-block;
    margin-left: var(--s2);
    color: var(--dc-pink);
    transition: transform 160ms var(--dc-ease);
  }

  .sponsorship-download:focus-visible > span {
    transform: translate(2px, -2px);
  }

  .sponsorship-download small {
    display: block;
    margin-top: var(--s2);
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
    font-weight: 400;
  }

  .package-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s5);
    padding-bottom: var(--s6);
  }

  .package-plan {
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    min-width: 0;
    padding: var(--s5);
    border: 1px solid color-mix(in oklch, var(--dc-ink) 16%, var(--dc-paper));
    border-radius: 12px;
    background: var(--dc-paper-light);
  }

  @supports (grid-template-rows: subgrid) {
    .package-plan {
      grid-template-rows: subgrid;
      grid-row: span 6;
      row-gap: 0;
    }
  }

  .package-heading {
    align-self: start;
  }

  .package-heading h4 {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
    line-height: 1.15;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .package-family {
    padding: 4px 9px;
    border-radius: 6px;
    background: var(--dc-yellow);
    color: var(--dc-ink);
    font-family: var(--font-body);
    font-size: var(--dc-text-meta);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .package-tier {
    max-width: 100%;
  }

  .package-price {
    display: flex;
    align-items: baseline;
    gap: var(--s2);
    margin-top: var(--s4);
    font-size: clamp(36px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: var(--tracking-heading);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .package-currency {
    color: var(--dc-muted);
    font-size: var(--dc-text-small);
    font-weight: 500;
    letter-spacing: 0;
  }

  .package-description {
    margin-top: var(--s2);
    color: var(--dc-muted);
    font-size: var(--dc-text-small);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .package-highlights {
    display: grid;
    align-content: start;
    gap: var(--s3);
    margin-block: var(--s5);
    color: var(--dc-ink);
    font-size: var(--dc-text-small);
    line-height: 1.55;
  }

  .package-highlights li {
    position: relative;
    padding-left: 22px;
  }

  .package-highlights li::before {
    position: absolute;
    top: 0.5em;
    left: 0;
    width: 9px;
    height: 5px;
    color: var(--dc-pink);
    border-bottom: 1.5px solid currentColor;
    border-left: 1.5px solid currentColor;
    transform: rotate(-45deg);
    content: '';
  }

  .package-allocation {
    padding-top: var(--s4);
    border-top: 1px solid var(--dc-rule);
  }

  .package-passes {
    font-size: var(--dc-text-small);
    font-weight: 600;
    line-height: 1.5;
  }

  .package-qualification {
    margin-top: var(--s3);
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
    line-height: 1.55;
  }

  .package-enquiry {
    position: relative;
    display: flex;
    isolation: isolate;
    min-height: var(--dc-control-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    margin-top: var(--s5);
    padding: var(--s2) var(--s3);
    border: 1px solid var(--dc-ticket-action-outline);
    border-radius: 6px;
    background: var(--dc-paper-light);
    color: var(--dc-ink);
    font-size: var(--dc-text-small);
    font-weight: 600;
    transition: transform 140ms var(--dc-ease);
  }

  .package-enquiry::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: color-mix(in oklch, var(--dc-yellow) 26%, var(--dc-paper-light));
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms var(--dc-ease);
    content: '';
  }

  .package-enquiry:focus-visible::before,
  .package-enquiry:active::before {
    opacity: 1;
  }

  .package-enquiry > span:first-child {
    color: var(--dc-pink);
    transition: transform 160ms var(--dc-ease);
  }

  .custom-sponsorship {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s6);
    padding-block: var(--s6);
    border-block: 1px solid var(--dc-rule);
  }

  .custom-sponsorship > div {
    max-width: 620px;
  }

  .custom-sponsorship .section-caption {
    margin-bottom: var(--s2);
  }

  .custom-sponsorship h3 {
    font-size: var(--dc-text-card);
    letter-spacing: -0.025em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .custom-sponsorship > div > p:last-child {
    margin-top: var(--s4);
    color: var(--dc-muted);
    font-size: var(--dc-text-small);
    line-height: 1.65;
  }

  .custom-sponsorship .sponsor-button {
    margin-top: 0;
    border: 1px solid var(--dc-rule);
    background: var(--dc-paper-light);
    font-size: var(--dc-text-small);
  }

  .custom-sponsorship .sponsor-button span {
    color: var(--dc-pink);
  }

  .past-sponsors-section {
    padding-block: 16px 88px;
  }

  .past-sponsors-intro {
    max-width: 620px;
    margin-bottom: 34px;
  }

  .past-sponsors-intro h2 {
    font-size: clamp(34px, 4vw, 48px);
  }

  .past-sponsors-intro > p:last-child {
    margin-top: 18px;
    color: var(--dc-muted);
    line-height: 1.65;
  }

  .past-sponsors-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .past-sponsors-list a {
    position: relative;
    display: grid;
    grid-template-rows: 88px auto;
    gap: 16px;
    height: 100%;
    padding: 18px;
    font-size: var(--dc-text-small);
    font-weight: 600;
  }

  .past-sponsor-logo {
    display: grid;
    height: 88px;
    padding: 12px 20px;
    place-items: center;
    border-radius: 6px;
    background: var(--dc-paper-light);
  }

  .past-sponsor-logo img {
    width: 100%;
    height: 64px;
    object-fit: contain;
  }

  .past-sponsor-arrow {
    position: absolute;
    right: 18px;
    bottom: 18px;
    color: var(--dc-pink);
  }

  .past-sponsor-logo + span {
    padding-right: 24px;
  }

  .faq-section {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: 80px;
    padding-block: 95px 100px;
  }

  .faq-intro p {
    margin-top: 20px;
    color: var(--dc-muted);
    font-size: var(--dc-text-body);
  }

  .faq-item {
    border-bottom: 1px solid var(--dc-rule);
  }

  summary {
    display: flex;
    min-height: 70px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    cursor: pointer;
    font-size: var(--dc-text-body);
    font-weight: 600;
    line-height: 1.4;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary span {
    color: var(--dc-pink);
    font-size: 27px;
    font-weight: 400;
    transition: transform 180ms var(--dc-ease);
  }

  details[open] summary span {
    transform: rotate(45deg);
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    padding-bottom: 24px;
    color: var(--dc-muted);
    font-size: var(--dc-text-body);
    line-height: 1.65;
  }

  .has-faq-motion .faq-answer p {
    opacity: 0;
    transform: translateY(-14px);
    transition: transform 180ms var(--dc-ease), opacity 180ms var(--dc-ease);
  }

  .has-faq-motion .faq-item.is-open .faq-answer p {
    opacity: 1;
    transform: translateY(0);
  }

  .checkout-dialog {
    isolation: isolate;
    width: min(100% - 32px, 520px);
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--dc-ink);
    overflow: hidden;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: transform 180ms var(--dc-ease), opacity 180ms var(--dc-ease);
  }

  .checkout-dialog::backdrop {
    background: oklch(0.2 0.006 83 / 0.3);
    backdrop-filter: blur(3px);
  }

  .checkout-panel {
    position: relative;
    z-index: 1;
    max-height: calc(100dvh - 32px);
    overflow-x: hidden;
    overflow-y: auto;
    overflow-anchor: none;
    scrollbar-gutter: stable;
  }

  .checkout-surface {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    background: var(--dc-paper);
    transform-origin: top;
    pointer-events: none;
  }

  .checkout-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .checkout-content {
    position: relative;
    padding: clamp(26px, 5vw, 42px);
  }

  .checkout-content > :not(.checkout-dismiss) {
    position: relative;
    z-index: 1;
  }

  .checkout-art .ticket-illustration {
    top: 50%;
    bottom: auto;
    width: 90%;
    max-width: none;
    opacity: 0.1;
    transform: translateY(-50%);
  }

  .checkout-dialog[data-ticket-featured='true'] .ticket-illustration {
    opacity: 0.08;
  }

  .checkout-dialog[data-visible='true'] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .checkout-panel .section-caption {
    padding-right: 30px;
  }

  .checkout-panel h2 {
    max-width: 330px;
    font-size: 40px;
  }

  .checkout-dismiss {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
  }

  .checkout-close {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border-radius: 8px;
    color: var(--dc-ink);
    font-size: 28px;
    line-height: 1;
    transition: transform 140ms var(--dc-ease);
  }

  .checkout-selection {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 30px;
    padding-block: 20px;
    border-block: 1px solid var(--dc-rule);
  }

  .checkout-selection-label {
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
  }

  .checkout-ticket-name {
    margin-top: 6px;
    font-family: var(--font-display);
    font-size: var(--dc-text-subtitle);
    font-weight: 600;
    letter-spacing: var(--tracking-heading);
  }

  .checkout-ticket-price {
    font-size: var(--dc-text-subtitle);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .checkout-notice {
    display: grid;
    gap: 6px;
    margin-top: 24px;
    font-size: var(--dc-text-body);
    line-height: 1.65;
  }

  .checkout-notice p {
    font-weight: 700;
  }

  .checkout-notice span, .checkout-payment-note {
    color: var(--dc-muted);
  }

  .checkout-payment-button {
    width: 100%;
    justify-content: center;
    margin-top: 24px;
    background: var(--dc-paper-light);
    color: var(--dc-ink);
    box-shadow: inset 0 0 0 1px var(--dc-ticket-action-outline);
    cursor: pointer;
  }

  .checkout-payment-button:disabled {
    background: oklch(0.84 0.013 91);
    color: var(--dc-muted);
    box-shadow: none;
    cursor: not-allowed;
  }

  .checkout-payment-note {
    margin-top: 12px;
    font-size: var(--dc-text-meta);
    line-height: 1.5;
    text-align: center;
  }

  .devcon-page [hidden] {
    display: none !important;
  }

  .checkout-buyer-fields {
    display: grid;
    gap: 8px;
    margin-top: 24px;
  }

  .checkout-buyer-fields label, .checkout-coupon-content > label {
    font-size: var(--dc-text-small);
    font-weight: 600;
  }

  .checkout-buyer-fields label:not(:first-child) {
    margin-top: 8px;
  }

  .checkout-buyer-form input {
    width: 100%;
    min-width: 0;
    min-height: 46px;
    padding: 10px 12px;
    border: 1px solid var(--dc-rule);
    border-radius: 6px;
    background: var(--dc-paper-light);
    color: var(--dc-ink);
    font: inherit;
    font-size: var(--dc-text-body);
    caret-color: var(--dc-pink);
  }

  .checkout-buyer-form input:focus {
    border-color: var(--dc-ink);
    outline: 1px solid var(--dc-ink);
    outline-offset: 0;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--dc-pink) 8%, transparent);
  }

  .checkout-buyer-form input[aria-invalid='true'] {
    border-color: var(--dc-pink);
  }

  .checkout-buyer-form input[aria-invalid='true']:focus {
    outline-color: var(--dc-pink);
  }

  .checkout-privacy-note {
    margin-top: 6px;
    color: var(--dc-muted);
    font-size: var(--dc-text-meta);
    line-height: 1.6;
  }

  .checkout-coupon {
    position: relative;
    margin-top: 14px;
  }

  .checkout-coupon summary {
    min-height: 48px;
    font-size: var(--dc-text-small);
  }

  .checkout-coupon-content, .checkout-after-coupon {
    display: flow-root;
  }

  .checkout-coupon[data-coupon-open='false'] summary span {
    transform: rotate(0);
  }

  .checkout-coupon-content > label {
    display: block;
    margin-block: 4px 8px;
  }

  .checkout-coupon-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checkout-coupon-controls input {
    flex: 1;
    text-transform: uppercase;
  }

  .checkout-coupon-controls button {
    min-height: 46px;
    padding-inline: 10px;
    border: 1px solid var(--dc-rule);
    border-radius: 6px;
    background: var(--dc-paper-light);
    font-size: var(--dc-text-small);
    font-weight: 600;
  }

  .checkout-coupon-controls button:disabled {
    color: var(--dc-muted);
    cursor: not-allowed;
  }

  [data-checkout-coupon-status] {
    margin-top: 10px;
    color: var(--dc-muted);
    font-size: var(--dc-text-small);
    line-height: 1.55;
  }

  .checkout-quote {
    display: grid;
    gap: 10px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--dc-rule);
    font-size: var(--dc-text-small);
    font-variant-numeric: tabular-nums;
  }

  .checkout-quote > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .checkout-quote dd {
    text-align: right;
  }

  .checkout-total {
    font-size: var(--dc-text-body);
    font-weight: 700;
  }

  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 3px solid var(--dc-pink);
    outline-offset: 5px;
  }

  .ticket-buy-button:focus-visible {
    outline-color: var(--dc-ticket-action-outline);
  }

  @media (forced-colors: active) {
    .package-enquiry:focus-visible {
      outline-color: Highlight;
    }

    .sponsorship-download::before {
      border-color: Highlight;
      background: Canvas;
      box-shadow: none;
    }

    .sponsorship-download:focus-visible {
      outline-color: Highlight;
    }

    .checkout-buyer-form input:focus {
      outline: 2px solid Highlight;
      outline-offset: 2px;
      box-shadow: none;
    }

    .checkout-buyer-form input[aria-invalid='true']:focus {
      outline-color: Highlight;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .package-enquiry:hover::before {
      opacity: 1;
    }

    .package-enquiry:hover > span:first-child {
      transform: translate(2px, -2px);
    }

    .sponsorship-download:hover {
      transform: translateY(-1px);
    }

    .sponsorship-download:hover::before {
      opacity: 1;
    }

    .sponsorship-download:hover > span {
      transform: translate(2px, -2px);
    }

    .section-nav a:hover, .mobile-section-nav a:hover {
      color: var(--dc-pink);
    }

    .button:hover, .ticket-buy-button:not(:disabled):hover {
      transform: translateY(-2px);
    }

    .ticket-buy-button:not(:disabled):hover {
      background: var(--dc-paper);
    }

    .checkout-close:hover {
      background: var(--dc-yellow);
    }

    .sponsor-item a:hover .sponsor-visit {
      transform: translate(2px, -2px);
