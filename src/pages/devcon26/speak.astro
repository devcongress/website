---
import Base from '../../layouts/Base.astro';
---

<Base title="Speaker applications are closed | DevCon26" description="Join DevCon26 in Accra on 19 December 2026. Speaker applications are closed and tickets are available." showFooter={false}>
  <main class="speaker-page">
    <section aria-labelledby="speaker-heading">
      <img class="banner" src="/images/devcon26/hero-may-speakers.webp" width="1100" height="734" alt="Four speakers together at the May DevCongress meetup" />
      <div class="notice">
        <div class="message">
          <a class="back" href="/devcon26/#speakers" aria-label="Back to DevCon26 speakers">← DevCon26</a>
          <h1 id="speaker-heading">Speaker applications are closed.</h1>
        </div>
        <div class="invitation">
          <p>You can still join us at DevCon26.</p>
          <p class="details"><time datetime="2026-12-19">19 December 2026</time> · Accra Digital Center</p>
          <div class="badge-art" aria-hidden="true">
            <img src="/images/devcon26/social-card/devcon26-v11-base-1080x1350.png" alt="" width="1080" height="1350" />
          </div>
          <a class="button ticket" href="/devcon26/#tickets">Get a ticket <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  :global(body:has(.speaker-page)) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .speaker-page {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .speaker-page section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, min(50svh, max(0px, calc(100svh - 340px)))) 1fr;
  }

  .banner {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .notice {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3fr 2fr;
    align-content: start;
    align-items: center;
    gap: clamp(32px, 7vw, 120px);
    padding: clamp(16px, 3vh, 32px) clamp(24px, 6vw, 108px) 20px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #a90057;
    font-weight: 600;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 4.5vw, 5rem);
    line-height: 1.02;
    text-wrap: balance;
  }

  .invitation {
    padding-top: clamp(0px, 7svh - 32px, 44px);
  }

  .invitation > p:first-child {
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
    line-height: 1.3;
  }

  .badge-art {
    position: absolute;
    inset: 0 0 0 59%;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  .badge-art img {
    position: absolute;
    top: 8%;
    left: 36%;
    width: auto;
    height: 86%;
    max-height: 380px;
    max-width: 76%;
    object-fit: contain;
    opacity: 0.40;
    transform: translateX(-50%) rotate(14deg);
  }

  .details {
    margin-top: 4px;
    color: #50504d;
  }

  .ticket {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 12px 18px 12px 20px;
    border-radius: 8px;
    background: var(--yellow);
    color: var(--text);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 24px;
  }

  .ticket span {
    display: inline-grid;
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    place-items: center;
    font-size: 20px;
    line-height: 1;
  }

  a:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 5px;
  }

  @media (max-width: 760px) {
    .ticket {
      min-height: 50px;
    }

    .ticket span {
      font-size: 18px;
    }
  }

  @media (max-width: 720px) {
    .speaker-page section {
      grid-template-rows: min(66vw, max(0px, calc(100svh - 505px))) 1fr;
    }

    h1 {
      max-width: 19ch;
      font-size: clamp(1.85rem, 8vw, 2.2rem);
      line-height: 1.08;
    }

    .invitation {
      position: relative;
      isolation: isolate;
      padding-top: 0;
    }

    .badge-art {
      inset: -22px -12px -76px 0;
    }

    .badge-art img {
      top: 5%;
      left: 57%;
      height: 88%;
      opacity: 0.32;
    }

    .notice {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: clamp(28px, 4svh, 40px) 24px 76px;
    }
  }
</style>
