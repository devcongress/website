---
import Base from '../../layouts/Base.astro';
import FormDropdown from '../../components/FormDropdown.astro';
import { EVENT_SUBMISSION_TURNSTILE_SITE_KEY } from '../../lib/events';
const localPreview = import.meta.env.DEV;
const apiOrigin = import.meta.env.PUBLIC_DEVCON26_API_ORIGIN || 'https://em.devcongress.org';
---

<Base title="Apply to speak | DevCon26" description="Share something useful with the DevCon26 community. Apply to speak at our annual conference." showFooter={false}>
  <main class="speaker-page" data-speaker-page data-api-origin={apiOrigin} data-local-preview={localPreview ? 'true' : undefined}>
    <div class="page-heading">
      <div><p class="eyebrow">DevCon26 · Call for Speakers</p><h1>Something worth <em>sharing?</em></h1></div>
      <p class="intro">Bring your experience, your experiments, and your perspective to the community.</p>
    </div>
    <p id="cfp-status" data-cfp-status role="status" tabindex="-1">Checking the Call for Speakers…</p>
    <form data-cfp-form novalidate hidden>
      <ol class="stepper" aria-label="Application steps">
        {['About you', 'Your session', 'Proposal details', 'Review'].map((label, index) => (
          <li data-step-label={index} aria-current={index === 0 ? 'step' : undefined}>
            <span class="step-number" data-step-number aria-hidden="true">{index + 1}</span><span>{label}</span>
          </li>
        ))}
      </ol>
      <section class="step-panel" data-step="0" aria-labelledby="about-heading">
        <h2 id="about-heading">About you</h2>
        <div class="field-grid">
        <label>Your name<input name="speaker_name" maxlength="120" autocomplete="name" required /></label>
        <label>Email<input name="speaker_email" type="email" maxlength="254" autocomplete="email" required /></label>
        <label class="full-width">Short bio<textarea name="bio" maxlength="4000" rows="4" required></textarea></label>
        </div>
        <div class="actions"><span>Step 1 of 4</span><button type="button" data-next="1" disabled>Continue →</button></div>
      </section>
      <section class="step-panel" data-step="1" aria-labelledby="session-heading" hidden>
        <h2 id="session-heading">Your session</h2>
        <label>Session title<input name="title" maxlength="200" required /></label>
        <div class="field-grid">
          {[['topic', 'Topic track', 'Choose a track'], ['session_type', 'Session type', 'Choose a format']].map(([name, label, placeholder]) => (
            <FormDropdown name={name} label={label} placeholder={placeholder} />
          ))}
        </div>
        <div class="actions"><button class="secondary" type="button" data-back="0"><svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m8 4-6 6 6 6M2 10h16" /></svg>Back</button><span>Step 2 of 4</span><button type="button" data-next="2" disabled>Continue →</button></div>
      </section>
      <section class="step-panel" data-step="2" aria-labelledby="details-heading" hidden>
        <h2 id="details-heading">Proposal details</h2>
        <div class="field-grid proposal-fields">
          <label>Abstract
            <textarea name="abstract" rows="7" maxlength="12000" aria-describedby="abstract-limit abstract-error" required></textarea>
            <small id="abstract-limit" data-abstract-limit></small>
            <small id="abstract-error" class="field-error" hidden></small>
          </label>
          <fieldset class="outcomes-editor" aria-describedby="outcomes-hint outcomes-progress outcomes-error">
            <legend>Learning outcomes</legend>
            <small id="outcomes-hint">Add 3–5 concrete things attendees will understand, be able to do, or take away. Up to 300 characters each.</small>
            <div data-outcome-rows></div>
            <button type="button" class="outcome-add" data-add-outcome>＋ Add another outcome</button>
            <small id="outcomes-progress" aria-live="polite"></small>
            <small id="outcomes-error" class="field-error" hidden></small>
            <textarea name="learning_outcomes" hidden></textarea>
          </fieldset>
        </div>
        <div class="actions">
          <button class="secondary" type="button" data-back="1">← Back</button>
          <button type="button" data-next="3" disabled>Preview proposal →</button>
        </div>
      </section>
      <section class="step-panel" data-step="3" aria-labelledby="review-heading" hidden>
        <h2 id="review-heading" tabindex="-1">Review your proposal</h2>
        <p class="review-intro">Check your details before sending. You won’t be able to edit your proposal after submission.</p>
        <dl class="review-details">
          {[['speaker_name', 'Your name'], ['speaker_email', 'Email'], ['bio', 'Short bio'], ['title', 'Session title'], ['topic', 'Topic track'], ['session_type', 'Session type'], ['abstract', 'Abstract']].map(([name, label]) => (
            <div><dt>{label}</dt><dd data-review-field={name}></dd></div>
          ))}
          <div><dt>Learning outcomes</dt><dd><ol data-review-outcomes></ol></dd></div>
        </dl>
        <div class="submit-footer">
          {!localPreview && <div class="cf-turnstile" data-size="compact" data-sitekey={EVENT_SUBMISSION_TURNSTILE_SITE_KEY} data-action="cfp_submission"></div>}
          {localPreview && <p class="preview-note">Local preview: this button shows the confirmation only. Nothing will be sent.</p>}
          <div class="actions">
            <button class="secondary" type="button" data-back="2">← Back</button>
            <button type="submit">{localPreview ? 'Preview confirmation ↗' : 'Submit proposal ↗'}</button>
          </div>
        </div>
      </section>
    </form>
    <section class="submission-result" data-submission-result aria-labelledby="submission-heading" hidden>
      <div class="result-topline"><span>DevCon26 · Call for speakers</span><span class="result-status">{localPreview ? 'Confirmation preview' : 'Proposal submitted'}</span></div>
      <h1 id="submission-heading" tabindex="-1">Thanks for<br /><em>sharing your idea.</em></h1>
      <p class="result-intro">Thank you for offering your time and experience to the DevCongress community.</p>
      <div class="proposal-receipt" data-proposal-receipt hidden>
        <p class="receipt-label">Your proposal</p>
        <h2 data-result-title></h2>
        <p data-result-format></p>
      </div>
      <div class="result-next">
        <h2>What happens next?</h2>
        <p>The team reviews proposals for the DevCon26 programme. If selected, you’ll hear from us about next steps.</p>
      </div>
      <div class="result-actions">
        <a class="result-home" href="/devcon26/">Back to DevCon26 <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    {localPreview && <p class="preview-note" data-preview-note hidden>Local preview only. Nothing was submitted or sent.</p>}
    <noscript>Enable JavaScript to complete your speaker application.</noscript>
  </main>
  {!localPreview && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

<script>
  const page = document.querySelector<HTMLElement>('[data-speaker-page]')!;
  const form = page.querySelector<HTMLFormElement>('[data-cfp-form]')!;
  const status = page.querySelector<HTMLElement>('[data-cfp-status]')!;
  const endpoint = new URL('/api/cfp/conferences/2026', page.dataset.apiOrigin);
  const localPreview = page.dataset.localPreview === 'true';
  const settingsEndpoint = localPreview ? '/__local/cfp/devcon26' : endpoint;
  let abstractLimit = 300;
  let busy = false;
  let currentStep = 0;
  const closeChoices: Array<() => void> = [];

  const result = page.querySelector<HTMLElement>('[data-submission-result]')!;
  const heading = page.querySelector<HTMLElement>('.page-heading')!;

  function showSubmissionResult() {
    closeChoices.forEach((close) => close());
    const title = form.querySelector<HTMLInputElement>('[name="title"]')!.value.trim();
    const format = form.querySelector<HTMLInputElement>('[name="session_type"]')!.value.replaceAll('_', ' ');
    const topic = form.querySelector<HTMLInputElement>('[name="topic"]')!.value.replaceAll('_', ' ');
    const receipt = result.querySelector<HTMLElement>('[data-proposal-receipt]')!;
    receipt.hidden = !title && !localPreview;
    result.querySelector('[data-result-title]')!.textContent = title || 'Building useful things, together';
    result.querySelector('[data-result-format]')!.textContent = [format, topic].filter(Boolean).join(' · ') || 'Example proposal · Local preview';
    form.hidden = true;
    heading.hidden = true;
    status.hidden = true;
    result.hidden = false;
    page.querySelector<HTMLElement>('[data-preview-note]')?.removeAttribute('hidden');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      result.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }], {
        duration: 240,
        easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      });
    }
    result.querySelector<HTMLElement>('#submission-heading')!.focus({ preventScroll: true });
    result.scrollIntoView({ block: 'start' });
  }

  function setupChoice(name: string, choices: string[]) {
    const root = form.querySelector<HTMLElement>(`[data-choice="${name}"]`)!;
    const input = root.querySelector<HTMLInputElement>('input')!;
    const trigger = root.querySelector<HTMLButtonElement>('.choice-trigger')!;
    const menu = root.querySelector<HTMLElement>('[role="listbox"]')!;
    let search = '';
    let lastKeyAt = 0;

    const close = () => {
      menu.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    };
    closeChoices.push(close);

    const options = choices.map((value) => {
      const option = document.createElement('button');
      option.type = 'button';
      option.tabIndex = -1;
      option.setAttribute('role', 'option');
      option.setAttribute('aria-selected', 'false');
      option.textContent = value.replaceAll('_', ' ');
      option.addEventListener('click', () => {
        input.value = value;
        trigger.querySelector('[data-choice-value]')!.textContent = option.textContent;
        trigger.removeAttribute('aria-invalid');
        trigger.removeAttribute('aria-describedby');
        options.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
        updateContinueButtons();
        close();
        trigger.focus();
      });
      menu.append(option);
      return option;
    });

    function positionMenu() {
      if (menu.hidden) return;
      const rect = trigger.getBoundingClientRect();
      const rootRect = root.getBoundingClientRect();
      const viewport = window.visualViewport;
      const viewportTop = viewport?.offsetTop ?? 0;
      const viewportBottom = viewportTop + (viewport?.height ?? window.innerHeight);
      const gap = 4;
      const edge = 8;
      const below = Math.max(0, viewportBottom - rect.bottom - gap - edge);
      const above = Math.max(0, rect.top - viewportTop - gap - edge);
      const desiredHeight = Math.min(menu.scrollHeight + 2, 256);
      const onTop = below < desiredHeight && above > below;
      menu.dataset.placement = onTop ? 'top' : 'bottom';
      menu.style.maxHeight = `${Math.min(256, onTop ? above : below)}px`;
      menu.style.top = onTop ? 'auto' : `${rect.bottom - rootRect.top + gap}px`;
      menu.style.bottom = onTop ? `${rootRect.bottom - rect.top + gap}px` : 'auto';
    }

    function open(last = false) {
      closeChoices.forEach((closeMenu) => closeMenu());
      menu.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      positionMenu();
      const selected = choices.indexOf(input.value);
      const option = options[selected >= 0 ? selected : last ? options.length - 1 : 0];
      option?.focus({ preventScroll: true });
      if (option) menu.scrollTop = option.offsetTop - menu.clientHeight / 2;
    }

    window.addEventListener('resize', positionMenu);
    window.addEventListener('scroll', positionMenu, true);
    window.visualViewport?.addEventListener('resize', positionMenu);
    window.visualViewport?.addEventListener('scroll', positionMenu);

    trigger.addEventListener('click', () => menu.hidden ? open() : close());
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        open(event.key === 'ArrowUp');
      }
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' || event.key === 'Tab') {
        if (event.key === 'Escape') {
          event.preventDefault();
          trigger.focus();
        }
        close();
        return;
      }
      const index = options.indexOf(document.activeElement as HTMLButtonElement);
      let next = index;

      if (event.key === 'ArrowDown') next = (index + 1) % options.length;
      else if (event.key === 'ArrowUp') next = (index - 1 + options.length) % options.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = options.length - 1;
      else if (event.key.length === 1 && event.key !== ' ') {
        search = Date.now() - lastKeyAt > 600 ? event.key : search + event.key;
        lastKeyAt = Date.now();
        next = options.findIndex((option) => option.textContent!.toLowerCase().startsWith(search.toLowerCase()));
      } else return;
      event.preventDefault();
      options[next]?.focus();
    });
    document.addEventListener('pointerdown', (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node)) close();
    });
  }

  function showStep(step: number) {
    closeChoices.forEach((close) => close());
    status.textContent = localPreview
      ? 'Local preview: live speaker settings loaded. You can test the form steps; submission is disabled.'
      : 'Applications are open. Your proposal goes directly to the annual conference review team.';
    currentStep = step;
    if (step === 3) {
      const data = new FormData(form);
      form.querySelectorAll<HTMLElement>('[data-review-field]').forEach((field) => {
        field.textContent = String(data.get(field.dataset.reviewField!) ?? '').trim();
      });
      const list = form.querySelector<HTMLOListElement>('[data-review-outcomes]')!;
      list.replaceChildren(...outcomeInputs().map((input) => {
        const item = document.createElement('li');
        item.textContent = input.value.trim();
        return item;
      }));
    }
    form.querySelectorAll<HTMLElement>('[data-step]').forEach((panel) => { panel.hidden = Number(panel.dataset.step) !== step; });
    form.querySelectorAll<HTMLElement>('[data-step-label]').forEach((label) => {
      const completed = Number(label.dataset.stepLabel) < step;
      label.classList.toggle('completed', completed);
      label.querySelector('[data-step-number]')!.textContent = completed ? '✓' : String(Number(label.dataset.stepLabel) + 1);
      if (Number(label.dataset.stepLabel) === step) label.setAttribute('aria-current', 'step');
      else label.removeAttribute('aria-current');
    });
    if (step === 3) form.querySelector<HTMLElement>('#review-heading')!.focus();
    else form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-step="${step}"] input, [data-step="${step}"] textarea`)?.focus();
  }

  function stepReady(step: number): boolean {
    if (step === 2) {
      const outcomes = outcomeInputs();
      return Boolean(abstractField.value.trim()) && wordCount(abstractField.value) <= abstractLimit
        && abstractField.validity.valid && outcomes.length >= 3 && outcomes.length <= 5
        && outcomes.every((input) => Boolean(input.value.trim()) && input.validity.valid);
    }
    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[data-step="${step}"] input:not([type="hidden"]), [data-step="${step}"] textarea`)];
    const fieldsReady = fields.every((field) => field.value.trim().length > 0 && field.validity.valid);
    const choicesReady = step !== 1 || [...form.querySelectorAll<HTMLInputElement>('[data-choice] input')].every((field) => field.value !== '');

    return fieldsReady && choicesReady;
  }

  function updateContinueButtons() {
    form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((button) => {
      button.disabled = busy || !stepReady(Number(button.dataset.next) - 1);
    });
  }

  form.addEventListener('input', updateContinueButtons);
  form.addEventListener('change', updateContinueButtons);
  window.addEventListener('pageshow', updateContinueButtons);

  const abstractField = form.querySelector<HTMLTextAreaElement>('[name="abstract"]')!;
  const outcomesField = form.querySelector<HTMLTextAreaElement>('[name="learning_outcomes"]')!;
  const touchedDetails = new Set<HTMLTextAreaElement>();
  const outcomeRows = form.querySelector<HTMLElement>('[data-outcome-rows]')!;
  const addOutcome = form.querySelector<HTMLButtonElement>('[data-add-outcome]')!;
  let outcomeId = 0;

  function outcomeInputs(): HTMLInputElement[] {
    return [...outcomeRows.querySelectorAll<HTMLInputElement>('input')];
  }

  function syncOutcomes() {
    const inputs = outcomeInputs();
    outcomesField.value = inputs.map((input) => input.value.trim()).join('\n');
    const completed = inputs.filter((input) => input.value.trim()).length;
    const remaining = Math.max(0, 3 - completed);
    const guidance = remaining
      ? `Add ${remaining} more to reach the minimum.`
      : completed < inputs.length ? 'Complete or remove the empty outcomes.' : 'Ready. You can add up to 5.';
    const progress = form.querySelector('#outcomes-progress')!;
    const message = `${completed} of 3 required outcomes added. ${guidance}`;
    if (progress.textContent !== message) progress.textContent = message;
    addOutcome.hidden = inputs.length >= 5;
    [...outcomeRows.children].forEach((row, index) => {
      row.querySelector('[data-outcome-number]')!.textContent = String(index + 1).padStart(2, '0');
      const input = row.querySelector('input')!;
      input.setAttribute('aria-label', `Learning outcome ${index + 1}`);
      input.placeholder = `Outcome ${index + 1}`;
      const remove = row.querySelector('button')!;
      remove.hidden = inputs.length === 1;
      remove.setAttribute('aria-label', `Remove learning outcome ${index + 1}`);
    });
    if (touchedDetails.has(outcomesField)) validateDetail(outcomesField);
    updateContinueButtons();
  }

  function appendOutcome(focus = true) {
    if (outcomeInputs().length >= 5) return;
    const row = document.createElement('div');
    row.className = 'outcome-row';
    const number = document.createElement('span');
    number.dataset.outcomeNumber = '';
    number.setAttribute('aria-hidden', 'true');
    const input = document.createElement('input');
    input.id = `learning-outcome-${outcomeId++}`;
    input.maxLength = 300;
    input.required = true;
    input.setAttribute('aria-describedby', 'outcomes-hint outcomes-error');
    input.addEventListener('input', syncOutcomes);
    input.addEventListener('blur', () => {
      touchedDetails.add(outcomesField);
      validateDetail(outcomesField);
    });
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'outcome-remove';
    remove.textContent = '×';
    remove.addEventListener('click', () => {
      const index = outcomeInputs().indexOf(input);
      row.remove();
      syncOutcomes();
      const inputs = outcomeInputs();
      inputs[Math.min(index, inputs.length - 1)]?.focus();
    });
    row.append(number, input, remove);
    outcomeRows.append(row);
    syncOutcomes();
    if (focus) input.focus();
  }

  addOutcome.addEventListener('click', () => appendOutcome());
  appendOutcome(false);


  function wordCount(value: string): number {
    return value.trim() ? value.trim().split(/\s+/).length : 0;
  }

  function updateWordCount() {
    const count = wordCount(abstractField.value);
    form.querySelector('[data-abstract-limit]')!.textContent = `${count} / ${abstractLimit} words`;
  }

  function validateDetail(field: HTMLTextAreaElement): boolean {
    const value = field.value.trim();
    let message = '';

    if (field === abstractField) {
      if (!value) message = 'Add an abstract for your proposal.';
      else if (wordCount(value) > abstractLimit) message = `Keep your abstract within ${abstractLimit} words.`;
      else if (value.length > 12000) message = 'Keep your abstract within 12,000 characters.';
    } else {
      const outcomes = value.split('\n').map((line) => line.trim()).filter(Boolean);

      if (outcomes.length < 3 || outcomes.length > 5) message = 'Add 3–5 learning outcomes.';
      else if (outcomeInputs().some((input) => !input.value.trim())) message = 'Complete or remove the empty outcomes.';
      else if (outcomes.some((line) => line.length > 300)) message = 'Keep each learning outcome within 300 characters.';
    }

    const error = form.querySelector<HTMLElement>(field === abstractField ? '#abstract-error' : '#outcomes-error')!;
    error.textContent = message;
    error.hidden = !message;
    field.setAttribute('aria-invalid', String(Boolean(message)));
    if (field === outcomesField) {
      outcomeInputs().forEach((input) => input.setAttribute('aria-invalid', String(Boolean(message))));
    }
    return !message;
  }

  for (const field of [abstractField, outcomesField]) {
    field.addEventListener('blur', () => {
      touchedDetails.add(field);
      validateDetail(field);
    });
    field.addEventListener('input', () => {
      updateWordCount();
      if (touchedDetails.has(field)) validateDetail(field);
    });
  }

  window.addEventListener('pageshow', updateWordCount);

  function validateStep(step: number): boolean {
    if (step === 2) {
      const invalid = [abstractField, outcomesField].filter((field) => {
        touchedDetails.add(field);
        return !validateDetail(field);
      });

      if (invalid.length) {
        showStep(step);
        if (invalid[0] === outcomesField) (outcomeInputs().find((input) => !input.value.trim()) ?? outcomeInputs()[0])?.focus();
        else invalid[0].focus();
        return false;
      }
      return true;
    }

    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(`[data-step="${step}"] input:not([type="hidden"]), [data-step="${step}"] textarea`)];
    const invalid = fields.find((field) => !field.checkValidity());

    if (invalid) {
      showStep(step);
      invalid.reportValidity();
      return false;
    }
    if (step === 1) {
      for (const root of form.querySelectorAll<HTMLElement>('[data-choice]')) {
        if (!root.querySelector<HTMLInputElement>('input')!.value) {
          showStep(step);
          const trigger = root.querySelector<HTMLButtonElement>('button')!;
          trigger.setAttribute('aria-invalid', 'true');
          trigger.setAttribute('aria-describedby', 'cfp-status');
          status.textContent = `Choose a ${root.dataset.choice === 'topic' ? 'topic track' : 'session format'} to continue.`;
          trigger.focus();
          return false;
        }
      }
    }
    return stepReady(step);
  }

  form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((button) => {
    button.addEventListener('click', () => {
      if (validateStep(currentStep)) showStep(Number(button.dataset.next));
    });
  });
  form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((button) => {
    button.addEventListener('click', () => showStep(Number(button.dataset.back)));
  });

  async function loadCall() {
    try {
      const response = await fetch(settingsEndpoint, { credentials: 'omit', cache: 'no-store', signal: AbortSignal.timeout(12000) });

      if (response.status === 404) {
        status.textContent = 'The Call for Speakers is not open right now. Please check back soon.';
        return;
      }
      if (!response.ok) throw new Error('unavailable');
      const call = await response.json();

      if (call.call_scope !== 'annual_conference' || !Array.isArray(call.topic_tracks) || !Array.isArray(call.session_types)) throw new Error('invalid');
      for (const [name, choices] of [['topic', call.topic_tracks], ['session_type', call.session_types]] as const) {
        if (!choices.length || choices.some((choice: unknown) => typeof choice !== 'string')) throw new Error('invalid');
        setupChoice(name, choices);
      }
      abstractLimit = Number(call.abstract_word_limit) || 300;
      updateWordCount();
      status.textContent = localPreview
        ? 'Local preview: live speaker settings loaded. You can test the form steps; submission is disabled.'
        : 'Applications are open. Your proposal goes directly to the annual conference review team.';
      form.hidden = false;
      updateContinueButtons();
    } catch {
      status.textContent = 'The application could not be loaded. Please refresh to try again.';
    }
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (busy || !result.hidden) return;
    if (currentStep < 3) {
      if (validateStep(currentStep)) showStep(currentStep + 1);
      return;
    }
    for (let step = 0; step < 3; step++) {
      if (!validateStep(step)) return;
    }
    if (localPreview) {
      showSubmissionResult();
      return;
    }
    const data = new FormData(form);
    const outcomes = String(data.get('learning_outcomes')).split('\n').map((line) => line.trim()).filter(Boolean);
    const abstract = String(data.get('abstract')).trim();
    const token = String(data.get('cf-turnstile-response') ?? '');

    if (!token) {
      status.textContent = 'Complete the human verification first.';
      status.focus();
      return;
    }
    busy = true;
    form.querySelectorAll<HTMLButtonElement>('button').forEach((button) => { button.disabled = true; });
    status.textContent = 'Submitting your proposal…';

    try {
      const response = await fetch(endpoint, {
        method: 'POST', credentials: 'omit', headers: { 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(20000),
        body: JSON.stringify({
          speaker_name: data.get('speaker_name'), speaker_email: data.get('speaker_email'), bio: data.get('bio'),
          title: data.get('title'), topic: data.get('topic'), session_type: data.get('session_type'), abstract,
          learning_outcomes: outcomes, turnstile_token: token, turnstile_action: 'cfp_submission',
        }),
      });
      const body = await response.json();

      if (response.status !== 202 || body.accepted !== true) throw new Error(body.error || 'Unable to submit. Please try again.');
      showSubmissionResult();
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Unable to submit. Please try again.';
      (window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
    } finally {
      busy = false;
      form.querySelectorAll<HTMLButtonElement>('button').forEach((button) => { button.disabled = false; });
      updateContinueButtons();
      if (result.hidden) status.focus();
    }
  });
  void loadCall();
</script>

