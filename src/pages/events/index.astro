  }
  .view-switcher-button svg { width: 18px; height: 18px; flex: none; }
  .view-switcher-button path,
  .view-switcher-button rect,
  .view-switcher-button circle { stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .view-switcher-button.is-active { color: var(--black); }
  .view-switcher-button:focus-visible,
  .calendar-nav-button:focus-visible,
