---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSection from '../components/HeroSection.astro';
import StatsBar from '../components/StatsBar.astro';
import MissionSection from '../components/MissionSection.astro';
import RolesMarquee from '../components/RolesMarquee.astro';
import ProgramsSection from '../components/ProgramsSection.astro';
import Devcon26Feature from '../components/Devcon26Feature.astro';
import MeetupsSection from '../components/MeetupsSection.astro';
import AdminsSection from '../components/AdminsSection.astro';
import PartnersSection from '../components/PartnersSection.astro';
import DonateSection from '../components/DonateSection.astro';
import InttegroDonationCheckout from '../components/InttegroDonationCheckout.astro';
import { getEvents } from '../lib/events';
import { DONATION_CHECKOUT_MODE } from '../lib/features';

const siteEntries = await getCollection('site');
const site        = siteEntries[0]!.data;
const admins      = await getCollection('admins');
const activities  = await getCollection('activities');
const partners    = await getCollection('partners');
const events      = await getEvents();
const useDonationModal = DONATION_CHECKOUT_MODE === 'modal';
---

<Base useDonationModal={useDonationModal}>
  <main>
    <HeroSection
      hero={site.hero}
      slackUrl={site.community_slack_url}
      donationPath={site.donation_path}
      useDonationModal={useDonationModal}
      youtubeEmbedUrl={site.youtube_embed_url}
    />
    <StatsBar stats={site.stats} />
    <MissionSection mission={site.mission_section} slackUrl={site.community_slack_url} />
    <RolesMarquee roles={site.roles} />
    <ProgramsSection activities={activities} />
    <Devcon26Feature />
    <MeetupsSection events={events} />
    <AdminsSection admins={admins} />
    <PartnersSection partners={partners} />
    <DonateSection
      donationPath={site.donation_path}
      useDonationModal={useDonationModal}
      donate={site.donate_section}
    />
  </main>
  {useDonationModal && (
    <InttegroDonationCheckout
      purchaseIntentId={site.inttegro_purchase_intent_id}
      fallbackPath={site.donation_path}
    />
  )}
</Base>
